{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-location.css' | asset_url | stylesheet_tag }}

{% include 'store-id' %}

<style>
  .rounded-orange-box {
    border: 1px solid var(--red-900);
    padding: 15px;
    border-radius: 3px;
    max-width: 800px;
    margin: auto;
    text-align: left;
  }
  .custom-padding.cart-item.responsive-mb {
    margin-bottom: 25px;
}
#MainContent iframe {
    height: 100vh !important ;
}
</style>

{% assign continue_url = '/collections/all' %}
{% if settings.continue_shopping_url != blank %}
  {% assign continue_url = settings.continue_shopping_url %}
{% endif %}

{%- assign needs_to_verify = false -%}

{% comment %}
  {{ cart.attributes.province }}
  {{ cart.attributes }}
  {{ customer.tags }}
{% endcomment %}

{% if cart.items.size > 0 %}
  {% if customer and need_to_verify %}
    <section class="fourohfour--container">
      <header class="fourohfour-title">
        <h2>Verify Your Account</h2>
      </header>

      <div class="fourohfour--inner">
        <p>We require you to verify your account before you can continue to make a purchase.</p>
        <p>To comply with certain laws and mandates we require a one time verification of this account.</p>
      </div>
    </section>
  {%- else -%}
    {% include 'custom-checkout-ht', settings: settings, block: block, cart: cart, store_id: store_id %}
  {%- endif -%}
{% else %}
  <div style="text-align: center; margin-top: 30px;">
