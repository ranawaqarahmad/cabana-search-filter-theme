{{ 'customer.css' | asset_url | stylesheet_tag }}
{{ 'accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
  padding-top: 16px;
  padding-bottom: 16px;
  }

  @media screen and (min-width: 1201px) {
  .section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  }

  .section-{{ section.id }}-padding {
  margin-top: 16px;
  margin-bottom: 16px;
  }

  @media screen and (min-width: 769px) {
  .section-{{ section.id }}-padding {
  margin-top: 32px;
  margin-bottom: 32px;
  }
  }

  @media screen and (min-width: 1201px) {
  .section-{{ section.id }}-padding {
  margin-top: 64px;
  margin-bottom: 64px;
  }
  }
{%- endstyle -%}

{% assign isElite = false %}

{% if customer and customer.tags contains 'ELITE' %}
  {% assign isElite = true %}
{% endif %}

<div class="account_intro js-account_intro hidden {% if isElite %}account_intro-elite{% endif %}">
  <div class="page-width account_intro-container js-account_intro-container">
    <div class="account_intro-membership">
      <h1 class="h3 account_intro-name">{{ 'customer.welcome' | t }}, {{ customer.first_name }}</h1>
      {% if isElite %}
        <p class="account_intro-member">{{ 'customer.member_status_elite' | t }}</p>
      {% else %}
        <p class="account_intro-member-normal">{{ 'customer.member_status_normal' | t }}</p>
      {% endif %}
    </div>
    {% comment %}TODO: Figure out where this information is going to come from{% endcomment %}
    {% assign memberSavings = 0.00 %}
    {% comment %}<div class="account_intro-info {% if isElite %}account_intro-info-elite js-account_intro-info-elite hidden{% endif %}">{% endcomment %}
      {% comment %}<p class="account_intro-savings-intro">{{ 'customer.savings' | t }}<strong> {{ memberSavings | money }} </strong>{{ 'customer.savings_2' | t }}</p>{% endcomment %}
    {% comment %}</div>{% endcomment %}
    <div class="account_intro-info {% if isElite %}account_intro-info-elite js-account_intro-info-elite hidden{% endif %}">
      <p class="account_intro-savings-intro js-account_intro-info-elite-expired hidden">{{ 'customer.elite_expired' | t }}</p>
    </div>
    <div class="account_intro-info {% if isElite %}account_intro-info-elite js-account_intro-info-elite hidden{% endif %}">
      <p class="account_intro-savings-intro js-account_intro-info-elite-expiring-soon hidden">{{ 'customer.elite_expiring_soon' | t }}</p>
    </div>
  </div>
</div>
<div class="customer account page-width account-sections-wrapper js-account-sections-wrapper">
  <div class="account_top_bar mgb-medium">
    <div class="left_side_box-account">
      <div class="account-nav">
        <ul>
          <li>
            <a href="#" class="nav-link js-orders-link js-nav-link">
              {% render 'theme-icons', icon: 'icon-package' %}
              <span class="nav-text">{{ 'customer.your_orders' | t }}</span>
              {% render 'theme-icons', icon: 'icon-chevron-right', class: "chevy" %}
            </a>
          </li>
          <li>
            <a href="#" class="nav-link js-account-link js-nav-link active">
              {% render 'theme-icons', icon: 'icon-user-circled' %}
              <span class="nav-text">{{ 'customer.manage_account' | t }}</span>
              {% render 'theme-icons', icon: 'icon-chevron-right' %}
            </a>
          </li>
          {% comment %}TODO: re-add when saved stores are ready{% endcomment %}
          {% comment %}<li>{% endcomment %}
            {% comment %}<a href="#" class="nav-link js-stores-link js-nav-link">{% endcomment %}
              {% comment %}{% render 'theme-icons', icon: 'icon-location' %}{% endcomment %}
              {% comment %}<span class="nav-text">{{ 'customer.saved_stores' | t }}</span>{% endcomment %}
              {% comment %}{% render 'theme-icons', icon: 'icon-chevron-right' %}{% endcomment %}
            {% comment %}</a>{% endcomment %}
          {% comment %}</li>{% endcomment %}
          <li>
            <a href="{{ routes.account_logout_url }}" class="nav-link js-nav-link logout-link js-logout-link logout_btns_customer">
              {% render 'theme-icons', icon: 'icon-logout' %}
              <span class="nav-text">{{ 'customer.sign_out' | t }}</span>
              {% render 'theme-icons', icon: 'icon-chevron-right' %}
            </a>
          </li>
        </ul>
      </div>
      <div class="section-heading__bar sp-small orders">
        <div class="small-hide">
          {% render 'breadcrumb' %}
        </div>
        <section class="section js-orders-section" style="display: none;">
          <h2 class="h1">{{ 'customer.customer_orders' | t }}</h2>
          {% paginate customer.orders by 20 %}
            {%- if customer.orders.size > 0 -%}
              <div class="order_list_table">
                <h5 class="h5">{{ 'customer.current_orders' | t }}</h5>
              </div>
              <div class="list_order_mainb">
                <ul>
                  {% comment %}TODO: come back and configure the loop for the past orders, based on if it was picked up already.{% endcomment %}
                  {%- for order in customer.orders -%}
                    <li class="order">
                      {% assign unique_items = order.line_items | map: 'product_id' | uniq %}
                      {% assign item_count = unique_items.size %}

                      <div class="content-wrapper">
                        <div class="thumb-image-wrapper {% if item_count != blank %}items-{{ item_count }}{% endif %}">
                          {% for line_item in order.line_items %}
                            {% assign current_product_id = line_item.product_id %}
                            {% if forloop.index <= 4 and unique_items contains current_product_id %}
                              {% assign unique_items = unique_items | remove: current_product_id %}
                              {% if item_count == 1 %}
                                {{ line_item.image | img_url: '150x150' | img_tag }}
                              {% elsif item_count == 2 %}
                                {{ line_item.image | img_url: '75x75' | img_tag }}
                              {% elsif item_count >= 3 %}
                                {{ line_item.image | img_url: '50x50' | img_tag }}
                              {% endif %}
                            {% endif %}
                          {% endfor %}
                        </div>

                        <div class="order-info">
                          <span class="order-created bold">{{ 'customer.purchase_date' | t }} {{ order.created_at | time_tag: format: 'date' }}</span>
                          {% comment %}TODO: format pickup and store address when available{% endcomment %}
                          {% comment %}<span class="order-pickup-date">Pickup {{ order.created_at | time_tag: format: 'date' }}</span>{% endcomment %}
                          {% comment %}<span class="order-store-address">{% endcomment %}
                          {% comment %}{% render 'theme-icons', icon: 'icon-location' %}{% endcomment %}
                          {% comment %}Store Address{% endcomment %}
                        {% comment %}</span>{% endcomment %}
                          <span class="five_colm">{{ order.total_net_amount | money_with_currency }}</span>

                          <div class="order-accordion small-hide">
                            <div class="faq-accordion-item">
                              <a class="view-products-btn accordion-toggle-btn" data-toggle="#accordion-toggle-content-{{ order.id }}">
                                {{ 'customer.view_products' | t }}
                                <span class="toggle-svg">
                                  {% render 'theme-icons', icon: 'icon-chevron-down' %}
                                </span>
                              </a>
                              <div id="accordion-toggle-content-{{ order.id }}" class="accordion-toggle-content">
                                <div class="rte">
                                  {%- for line_item in order.line_items -%}
                                    <div class="product-item">
                                      <div class="image-wrapper">
                                        {{ line_item.image | img_url: '60x60' | img_tag }}
                                      </div>
                                      <div class="content-wrapper">
                                        <p class="bold">{{ line_item.title }}</p>
                                        <div class="price-quantity">
                                          <span>{{ line_item.final_line_price | money }} </span>
                                          <span> x{{ line_item.quantity }}</span>
                                        </div>
                                      </div>
                                    </div>
                                  {%- endfor -%}
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="order-accordion medium-up-hide">
                        <div class="faq-accordion-item">
                          <a class="view-products-btn accordion-toggle-btn" data-toggle="#accordion-toggle-content-{{ order.id }}">
                            {{ 'customer.view_products' | t }}
                            <span class="toggle-svg">
                                  {% render 'theme-icons', icon: 'plus' %}
                                </span>
                          </a>
                          <div id="accordion-toggle-content-{{ order.id }}" class="accordion-toggle-content">
                            <div class="rte">
                              {%- for line_item in order.line_items -%}
                                <div class="product-item">
                                  <div class="image-wrapper">
                                    {{ line_item.image | img_url: '60x60' | img_tag }}
                                  </div>
                                  <div class="content-wrapper">
                                    <p class="bold">{{ line_item.title }}</p>
                                    <div class="price-quantity">
                                      <span>{{ line_item.final_line_price | money }} </span>
                                      <span> x{{ line_item.quantity }}</span>
                                    </div>
                                  </div>
                                </div>
                              {%- endfor -%}
                            </div>
                          </div>
                        </div>
                      </div>

                      <span class="order-link">
                        <a href="{{ order.customer_url }}">
                          {% render 'theme-icons', icon: 'icon-edit' %}
                          {{ 'customer.see_order' | t }}
                        </a>
                      </span>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {%- else -%}
              <p>{{ 'customer.orders.none' | t }}</p>
            {%- endif -%}
            {%- if paginate.pages > 1 -%}
              {%- if paginate.parts.size > 0 -%}
                <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
                  <ul role="list">
                    {%- if paginate.previous -%}
                      <li>
                        <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                          <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                          </svg>
                        </a>
                      </li>
                    {%- endif -%}

                    {%- for part in paginate.parts -%}
                      <li>
                        {%- if part.is_link -%}
                          <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                            {{- part.title -}}
                          </a>
                        {%- else -%}
                          {%- if part.title == paginate.current_page -%}
                            <span
                              aria-current="page"
                              aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                            >
                              {{- part.title -}}
                            </span>
                          {%- else -%}
                            <span>{{ part.title }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      </li>
                    {%- endfor -%}

                    {%- if paginate.next -%}
                      <li>
                        <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                          <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                          </svg>
                        </a>
                      </li>
                    {%- endif -%}
                  </ul>
                </nav>
              {%- endif -%}
            {%- endif -%}
          {% endpaginate %}
        </section>
        <section class="section js-account-section">
          <h2 class="h1">{{ 'customer.account_info' | t }}</h2>
          <a href="{{ routes.account_addresses_url }}" class="logout_btns_customer">
            {{- 'customer.account.view_addresses' | t -}}
          </a>
        </section>
        <section class="section js-stores-section" style="display: none;">
          <h2 class="h1">{{ 'customer.saved_stores' | t }}</h2>
        </section>
        <p class="logging-out-msg js-logging-out-msg hidden">{{ 'customer.logging_out' | t }}</p>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const accountWrapper       = document.querySelector('.js-account-sections-wrapper');
  const accountIntro         = document.querySelector('.js-account_intro-container');
  const accountIntroElements = document.querySelectorAll('.js-account_intro');
  const navLinks             = accountWrapper.querySelectorAll('.js-nav-link');
  const sections             = accountWrapper.querySelectorAll('.section');
  const province             = localStorage.getItem('global_province');
  const logoutButton         = document.querySelector('.js-logout-link');
  const logoutMessage        = document.querySelector('.js-logging-out-msg');
  const eliteInfoElements    = document.querySelectorAll('.js-account_intro-info-elite');
  const isExpiringSoon       = localStorage.getItem('elite_expiring_soon');
  const eliteExpiringSoon    = document.querySelectorAll('.js-account_intro-info-elite-expiring-soon');
  const isExpired            = localStorage.getItem('elite_expired_grace');
  const eliteExpired         = document.querySelectorAll('.js-account_intro-info-elite-expired');

  navLinks.forEach(link => {
    link.addEventListener('click', function (event) {
      const targetClass = 'js-' + link.classList[1].split('-')[1] + '-section';
      showSection(targetClass);
      setActiveLink(link);
    });
  });

  function showSection(sectionClass) {
    sections.forEach(section => {
      section.style.display = section.classList.contains(sectionClass) ? 'block' : 'none';
    });
  }

  function setActiveLink(activeLink) {
    navLinks.forEach(link => {
      link.classList.remove('active');
    });
    activeLink.classList.add('active');
  }

  if (isExpired === 'true') {
    eliteExpired.forEach(element => {
      element.classList.remove('hidden');
    });
  }

  if (isExpiringSoon === 'true') {
    eliteExpiringSoon.forEach(element => {
      element.classList.remove('hidden');
    });
  }

  if (province !== 'Alberta') {
    eliteInfoElements.forEach(element => {
      element.classList.remove('hidden');
    });
  }

  if (province !== 'British Columbia') {
    accountIntroElements.forEach(element => {
      element.classList.remove('hidden');
    });
  }

  if (logoutButton) {
    logoutButton.addEventListener('click', function () {
      logoutMessage.classList.remove('hidden');
    });
  }
});
</script>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
  ]
}
{% endschema %}
