function handleSection2InputsChange(field, errorDiv) {
  field.addEventListener('input', (e) => {
    let fieldActive = true;
    if (!field.value.trim()) {
      fieldActive = false;
    } else if (field.type === 'email' && !validateEmail()) {
      fieldActive = false;
    } else if (field.type === 'tel' && !validatePhone()) {
      fieldActive = false;
    } else if (field.type === 'date' && !validateDOB()) {
      fieldActive = false;
    }

    if (!fieldActive) {
      continueBtn.disabled = true;
      continueBtn.classList.add('disabled-checkout-btn');
      errorDiv.classList.remove('hidden');
    } else {
      errorDiv.classList.add('hidden');
    }

    if (checkIfFormValid()) {
      continueBtn.disabled = false;
      continueBtn.classList.remove('disabled-checkout-btn');
    }
  });
}

function validateEmail() {
  return regxEmail.test(section2Email.value);
}

function validatePhone() {
  return iti.isValidNumber();
}

function validateDOB() {
  const selectedDate = new Date(section2BirthDate.value);
  const today = new Date();
  const age = today.getFullYear() - selectedDate.getFullYear();
  return age >= 19;
}

function checkIfFormValid() {
  if (!section2FirstName.value) return false;
  if (!section2LastName.value) return false;
  if (!validateEmail()) return false;
  if (!validatePhone()) return false;
  if (!validateDOB()) return false;

  return true;
}

