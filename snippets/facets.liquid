{{ 'component-show-more.css' | asset_url | stylesheet_tag }}
{{ 'component-visual-display.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign total_active_values = 0
-%}

<div class="facets-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">

  {%- if filter_type == 'vertical' -%}
    <facet-filters-form class="facets main-collection__filter">
      <div class="filter-form__header large-up-hide">
        <h2 class="mg-none">{{ 'products.facets.filter_button' | t }}</h2>
        <button
          class="drawer__close filter-drawer__close button btn--tiny"
          type="button"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'theme-icons', icon: 'close' %}
        </button>
      </div>
      <form
        id="FacetFiltersForm"
        class="facets__form-vertical overflow-scrollbar"
      >
        {%- if results.terms -%}
          <input type="hidden" name="q" value="{{ results.terms | escape }}">
          <input name="sID" type="hidden" value="{{ store_id }}">
        {%- endif -%}

        {% if enable_filtering %}
          <div
            id="FacetsWrapperDesktop"
          >
            <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>

            {% assign counter = 1 %}

            {%- for filter in results.filters -%}
              {% liquid
                assign total_active_values = total_active_values | plus: filter.active_values.size
                case filter.presentation
                  when 'swatch'
                    assign has_visual_display = true
                    assign show_more_number = 15
                    assign visual_layout_class = 'facets-layout-grid facets-layout-grid--' | append: filter.presentation
                  else
                    assign has_visual_display = false
                    assign visual_layout_class = 'facets-layout-list'
                    assign show_more_number = 10
                endcase
                assign checkColorFilter = false
                assign filterLabel = filter.label | downcase
                if filterLabel == 'color' or filterLabel == 'colour'
                  assign checkColorFilter = true
                endif
              %}

              {% case filter.type %}
                {% when 'boolean', 'list' %}

                  {% assign check_filter_name = filter.param_name | escape %}
                  <details
                    id="Details-{{ counter }}-{{ section.id }}"
                    class="facets__disclosure-vertical {{ filter.label | handleize}} js-filter{% if check_filter_name == 'filter.v.availability' %} stock_option_filter{% endif %}{% if forloop.index != 1 %} not-first__child{% endif %}"
                    data-index="{{ forloop.index }}"
                    {% if check_filter_name == 'filter.v.availability' %}
                      open
                    {% endif %}
                  >
                    <summary
                      class="facets__summary caption-large focus-offset"
                      aria-label="{{ filter.label }} ({{ 'products.facets.filters_selected.one' | t: count: filter.active_values.size }})"
                    >
                      <div>
                        <span class="facets__summary-label h6">
                          {{- filter.label | escape }}
                          {%- if filter_type == 'vertical' -%}
                            <span class="facets__selected no-js-hidden{% if filter.active_values.size == 0 %} hidden{% endif %}">
                              ({{ filter.active_values.size }})</span
                            >
                          {%- endif -%}
                        </span>
                        {%- if filter_type == 'vertical' and filter.operator == 'AND' -%}
                          <span class="facets__and-helptext">
                            {{ 'products.facets.filter_and_operator_subtitle' | t }}
                          </span>
                        {%- endif -%}
                        {% render 'theme-icons', icon: 'icon-chevron-down' %}
                      </div>
                    </summary>
                    <div
                      id="Facet-{{ counter }}-{{ section.id }}"
                      class="parent-display facets__display-vertical"
                    >
                      {%- if filter_type != 'vertical' -%}
                        <div class="facets__header">
                          <div>
                            <span class="facets__selected no-js-hidden">
                              {{- 'products.facets.filters_selected' | t: count: filter.active_values.size -}}
                            </span>
                            {%- if filter.operator == 'AND' -%}
                              <span class="facets__and-helptext">
                                {{ 'products.facets.filter_and_operator_subtitle' | t }}
                              </span>
                            {%- endif -%}
                          </div>
                          <facet-remove>
                            <a href="{{ filter.url_to_remove }}" class="facets__reset link underlined-link">
                              {{ 'products.facets.reset' | t }}
                            </a>
                          </facet-remove>
                        </div>
                      {%- endif -%}
                      {% if filter.label == 'Strain Type' %}
                        <fieldset class="facets-wrap parent-wrap {% if filter_type == 'vertical' %} facets-wrap-vertical{% endif %} {% if color_swatch and checkColorFilter %} filter--color-swatch{% endif %}">
                          <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                          <ul
                            class="{% if has_visual_display %}visual_option_filter{% endif %} {{ visual_layout_class }}{% if filter_type == 'vertical' %} facets__list--vertical{% else %} facets__list{% endif %} list-unstyled no-js-hidden"
                            role="list"
                          >
                            {%- liquid
                              assign sorted_values = filter.values
                              # Keep the selected values grouped together when operator is AND
                              if filter.operator == 'AND'
                                assign active_filter_values = filter.values | where: 'active', true
                                assign inactive_filter_values = filter.values | where: 'active', false
                                assign sorted_values = active_filter_values | concat: inactive_filter_values
                              endif
                            -%}
                            {%- for value in sorted_values -%}
                              {% if value.label contains 'lineage' %}
                                {% liquid
                                  assign is_disabled = false
                                  if value.count == 0 and value.active == false
                                    assign is_disabled = true
                                  endif
                                %}

                                <li class="list-menu__item facets__item">
                                  <label
                                    for="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}"
                                    class="facets__label facet-checkbox{% if is_disabled %} facet-checkbox--disabled disabled{% endif %}{% if has_visual_display %} visual-display-parent visual-display-parent--{{ filter.presentation }}{% endif %}{% if value.active %} active{% endif %}"
                                  >
                                    <input
                                      class="custom-checkbox"
                                      type="checkbox"
                                      name="{{ value.param_name }}"
                                      value="{{ value.value }}"
                                      id="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}"
                                      {% if value.active %}
                                        checked
                                      {% endif %}
                                      {% if is_disabled %}
                                        disabled
                                      {% endif %}
                                    >
                                    {% if check_filter_name == 'filter.v.availability' %}
                                      <div class="slider-switch__stock">
                                        <div class="slider-switch__toggle">1</div>
                                      </div>
                                    {% endif %}
                                    {% if has_visual_display %}
                                      <div class="facets__visual-display-wrapper">
                                        {% render 'visual-display',
                                          type: value.display.type,
                                          value: value.display.value,
                                          presentation: filter.presentation
                                        %}
                                      </div>
                                    {% else %}
                                      <span class="checkbox-styling">
                                        {% render 'theme-icons', icon: 'check' %}
                                      </span>
                                    {% endif %}

                                    {% assign strain = value.label | split: ':' | last %}

                                    <span class="facet-checkbox__text" aria-hidden="true">{{- strain | escape }}</span>
                                    <span class="visually-hidden">
                                      (
                                      {%- if value.count == 1 -%}
                                        {{- 'products.facets.product_count_simple.one' | t: count: value.count -}}
                                      {%- else -%}
                                        {{- 'products.facets.product_count_simple.other' | t: count: value.count -}}
                                      {%- endif -%}
                                      )</span
                                    >
                                  </label>
                                </li>
                              {% endif %}
                            {%- endfor -%}
                          </ul>
                        </fieldset>
                      {% else %}
                        <fieldset class="facets-wrap parent-wrap {% if filter_type == 'vertical' %} facets-wrap-vertical{% endif %} {% if color_swatch and checkColorFilter %} filter--color-swatch{% endif %}">
                          <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                          <ul
                            class="{% if has_visual_display %}visual_option_filter{% endif %} {{ visual_layout_class }}{% if filter_type == 'vertical' %} facets__list--vertical{% else %} facets__list{% endif %} list-unstyled no-js-hidden"
                            role="list"
                          >
                            {%- liquid
                              assign sorted_values = filter.values
                              # Keep the selected values grouped together when operator is AND
                              if filter.operator == 'AND'
                                assign active_filter_values = filter.values | where: 'active', true
                                assign inactive_filter_values = filter.values | where: 'active', false
                                assign sorted_values = active_filter_values | concat: inactive_filter_values
                              endif
                            -%}
                            {%- for value in sorted_values -%}
                              {% liquid
                                assign is_disabled = false
                                if value.count == 0 and value.active == false
                                  assign is_disabled = true
                                endif
                              %}

                              <li class="list-menu__item facets__item{% if forloop.index > show_more_number and filter_type == 'vertical' %} show-more-item hidden{% endif %}">
                                {% if check_filter_name == 'filter.v.availability' %}
                                  <span class="h6">
                                    {{- value.label | escape }}
                                  </span>
                                {% endif %}

                                {% if color_swatch and checkColorFilter %}
                                  {% liquid
                                    assign colorValueDowncase = value.value | handleize
                                    assign color_file_name = value.value | handle | append: '.png'
                                    assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
                                  -%}
                                  <input
                                    type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    id="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}"
                                    {% if value.active %}
                                      checked
                                    {% endif -%}
                                    {% if value.count == 0 and value.active == false %}
                                      disabled
                                    {% endif %}
                                  >
                                  <label
                                    for="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}"
                                    title="{{ value.value }}"
                                    class="facet-checkbox color__swatches{% if value.count == 0 and value.active == false %} facet-checkbox--disabled{% endif %}"
                                    style="background-color:{{ colorValueDowncase | downcase }};{% if images[color_file_name] != blank %}  background-image: url({{ color_image }});{% endif %}"
                                  >
                                    <span class="hidden" aria-hidden="true">
                                      {{- value.label | escape }}</span
                                    >
                                  </label>
                                {% else %}
                                  <label
                                    for="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}"
                                    class="facets__label facet-checkbox{% if is_disabled %} facet-checkbox--disabled disabled{% endif %}{% if has_visual_display %} visual-display-parent visual-display-parent--{{ filter.presentation }}{% endif %}{% if value.active %} active{% endif %}"
                                  >
                                    <input
                                      class="custom-checkbox"
                                      type="checkbox"
                                      name="{{ value.param_name }}"
                                      value="{{ value.value }}"
                                      id="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}"
                                      {% if value.active %}
                                        checked
                                      {% endif %}
                                      {% if is_disabled %}
                                        disabled
                                      {% endif %}
                                    >
                                    {% if check_filter_name == 'filter.v.availability' %}
                                      <div class="slider-switch__stock">
                                        <div class="slider-switch__toggle">1</div>
                                      </div>
                                    {% endif %}
                                    {% if has_visual_display %}
                                      <div class="facets__visual-display-wrapper">
                                        {% render 'visual-display',
                                          type: value.display.type,
                                          value: value.display.value,
                                          presentation: filter.presentation
                                        %}
                                      </div>
                                    {% else %}
                                      <span class="checkbox-styling">
                                        {% render 'theme-icons', icon: 'check' %}
                                      </span>
                                    {% endif %}

                                    <span class="facet-checkbox__text" aria-hidden="true">
                                      {{- value.label | escape }}</span
                                    >
                                    <span class="visually-hidden">
                                      {{- value.label | escape }} (
                                      {%- if value.count == 1 -%}
                                        {{- 'products.facets.product_count_simple.one' | t: count: value.count -}}
                                      {%- else -%}
                                        {{- 'products.facets.product_count_simple.other' | t: count: value.count -}}
                                      {%- endif -%}
                                      )</span
                                    >
                                  </label>
                                {% endif %}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </fieldset>

                        {%- if filter.values.size > show_more_number and filter_type == 'vertical' -%}
                          <show-more-button>
                            <button
                              class="button-show-more link underlined-link no-js-hidden"
                              id="Show-More-{{ counter }}-{{ section.id }}"
                              type="button"
                            >
                              <span class="label-show-more label-text">
                                {{ 'products.facets.show_more' | t -}} {% render 'theme-icons', icon: 'icon-plus' %}
                              </span>
                              <span class="label-show-less label-text hidden">
                                {{ 'products.facets.show_less' | t -}} {% render 'theme-icons', icon: 'icon-minus' %}
                              </span>
                            </button>
                          </show-more-button>
                        {%- endif %}
                      {% endif %}
                    </div>
                  </details>
              {% endcase %}
              {% assign counter = counter |  plus: 1 %}
            {%- endfor -%}

            {% comment %} custom {% endcomment %}
            <style>
              .custom_range_slider { 
                  padding-bottom: 15px;
              }
              .custom_range_slider .new-price-input {
                width: 100%;
                display: flex; 
                margin-bottom: 20px;
                justify-content: space-between;
              } 
              .custom_range_slider input[type="number"]::-webkit-outer-spin-button,
              .custom_range_slider input[type="number"]::-webkit-inner-spin-button {
                -webkit-appearance: none;
              }
              .custom_range_slider .slider {
                height: 5px;
                position: relative;
                background: #ddd;
                border-radius: 5px;
              }
              .custom_range_slider .slider .progress {
                height: 5px;
                left: 0; 
                right: 0; 
                position: absolute;
                border-radius: 5px;
                background: #E1251C;
                display: block;
                z-index: 2; 
                margin-left: 5px;
              }
              .custom_range_slider .range-input {
                position: relative;
                top: -3px;
              }
              .custom_range_slider .range-input input {
                position: absolute;
                width: 99%;
                height: 5px;
                top: -5px;
                background: none;
                pointer-events: none;
                -webkit-appearance: none;
                -moz-appearance: none;
              }
              .custom_range_slider input[type="range"]::-webkit-slider-thumb{
                height: 17px;
                width: 17px;
                border-radius: 50%;
                background: #E1251C;
                pointer-events: auto;
                -webkit-appearance: none;
                box-shadow: none;
              }
              .custom_range_slider input[type="range"]::-webkit-slider-runnable-track{ 
                background-color: transparent;  
                height: 5px;
              } 
            </style>
            {%- for filter in results.filters -%}
              <details
                id="Details-{{ counter }}-{{ section.id }}"
                class="facets__disclosure-vertical js-filter new_custom_mp"
                data-index="{{ counter }}"
              >
                <summary class="facets__summary caption-large focus-offset">
                  <div>
                    <span class="h6">Price</span>
                    {% render 'theme-icons', icon: 'icon-chevron-down' %}
                  </div>
                </summary>
                <div
                  id="Facet-{{ counter }}-{{ section.id }}-mp"
                  class="facets__display-vertical"
                >
                  {%- liquid
                    assign filter_min_value = market_price_value_min | default: 0 |  times: 100

                    if market_price_value_max != 9999.0
                      assign filter_max_value = market_price_value_max | times: 100
                    else
                      assign filter_max_value = max_market_price | default: 100 | times: 100
                    endif

                    assign filter_range_max = max_market_price | default: 100 | times: 100
                    assign filter_min_progress = filter_min_value | divided_by: filter_range_max | times: 100.0
                    assign filter_max_progress = filter_max_value | divided_by: filter_range_max | times: 100.0
                  -%}
                    <div class="custom_range_slider mp_main">
                      <div class="new-price-input">
                        <div class="field_custom">
                          <div class="mp__min" data-mp-min="{{filter_min_value |  replace: '.0', ''}}">{{filter_min_value |  money }}</div> 
                        </div>
                        <div class="field_custom last">
                          <div class="mp__max" data-mp-max="{{filter_max_value |  replace: '.0', ''}}">{{filter_max_value |  money}}</div> 
                        </div>
                      </div>
                      <div class="slider">
                        <div class="progress"></div>
                      </div>
                      <div class="range-input">
                        <input type="range" class="range-min" data-mp-min-range min="{{filter_min_value}}" max="{{filter_max_value}}" value="{{filter_min_value}}" step="1" name="filter.v.mp.gte">
                        <input type="range" class="range-max" data-mp-max-range  min="{{filter_min_value}}" max="{{filter_max_value}}" value="{{filter_max_value}}" step="1" name="filter.v.mp.lte">
                      </div> 
                    </div>
                </div>
              </details>
              <script> 
                let priceGapMP =500;
                const rangeInput_mp = document.querySelectorAll(".mp_main .range-input input"), 
                range_mp = document.querySelector(".mp_main .slider .progress");
                let mp__min = document.querySelector('.mp__min')
                let mp__max = document.querySelector('.mp__max')
                rangeInput_mp.forEach((input) => {
                  input.addEventListener("input", (e) => {
                    let minVal = parseInt(rangeInput_mp[0].value),
                      maxVal = parseInt(rangeInput_mp[1].value);

                    if (maxVal - minVal < priceGapMP) {
                      if (e.target.className === "range-min") {
                        rangeInput_mp[0].value = maxVal - priceGapMP;
                      } else {
                        rangeInput_mp[1].value = minVal + priceGapMP;
                      }
                    } else {
                      let formattedPriceMin = (minVal / 100).toFixed(2);
                      let formattedPriceMax = (maxVal / 100).toFixed(2);
                      mp__min.innerHTML = '$'+formattedPriceMin;
                      mp__max.innerHTML = '$'+formattedPriceMax;
                      range_mp.style.left = (minVal / rangeInput_mp[0].max) * 100 + "%";
                      range_mp.style.right = 100 - (maxVal / rangeInput_mp[1].max) * 100 + "%";
                    } 

                  });
                });
              </script>


              
              <details
                id="Details-{{ counter }}-{{ section.id }}"
                class="facets__disclosure-vertical js-filter new_custom_cbd"
                data-index="{{ counter }}"
              >
                <summary class="facets__summary caption-large focus-offset">
                  <div>
                    <span class="h6">CBD</span>
                    {% render 'theme-icons', icon: 'icon-chevron-down' %}
                  </div>
                </summary>
                <div
                  id="Facet-{{ counter }}-{{ section.id }}"
                  class="facets__display-vertical"
                >
                  {%- liquid
                    assign filter_min_value = cbd_value_min | default: 0
                    assign filter_max_value = cbd_value_max | default: 100
                    assign filter_range_max = 100
                    assign filter_min_progress = filter_min_value | divided_by: filter_range_max | times: 100.0
                    assign filter_max_progress = filter_max_value | divided_by: filter_range_max | times: 100.0
                  -%}


                    <div class="custom_range_slider cbd_main">
                      <div class="new-price-input">
                        <div class="field_custom">
                          <div class="cbd__min" data-cbd-min="{{filter_min_value}}">{{filter_min_value}}%</div> 
                        </div>
                        <div class="field_custom last">
                          <div class="cbd__max" data-cbd-max="{{filter_max_value}}">{{filter_max_value}}%</div> 
                        </div>
                      </div>
                      <div class="slider">
                        <div class="progress"></div>
                      </div>
                      <div class="range-input">
                        <input type="range" class="range-min" data-cbd-min-range min="{{filter_min_value}}" max="{{filter_max_value}}" value="{{filter_min_value}}" step="1" name="filter.v.cbd.gte">
                        <input type="range" class="range-max" data-cbd-max-range  min="{{filter_min_value}}" max="{{filter_max_value}}" value="{{filter_max_value}}" step="1" name="filter.v.cbd.lte">
                      </div> 
                    </div>
                </div>
              </details>

              <script> 
                let priceGap = 5;
                const rangeInput_cbd = document.querySelectorAll(".cbd_main .range-input input"), 
                range_cbd = document.querySelector(".cbd_main .slider .progress");
                let cbd__min = document.querySelector('.cbd__min')
                let cbd__max = document.querySelector('.cbd__max')
                rangeInput_cbd.forEach((input) => {
                  input.addEventListener("input", (e) => {
                    let minVal = parseInt(rangeInput_cbd[0].value),
                      maxVal = parseInt(rangeInput_cbd[1].value);

                    if (maxVal - minVal < priceGap) {
                      if (e.target.className === "range-min") {
                        rangeInput_cbd[0].value = maxVal - priceGap;
                      } else {
                        rangeInput_cbd[1].value = minVal + priceGap;
                      }
                    } else {
                      cbd__min.innerHTML = minVal+'%';
                      cbd__max.innerHTML = maxVal+'%';
                      range_cbd.style.left = (minVal / rangeInput_cbd[0].max) * 100 + "%";
                      range_cbd.style.right = 100 - (maxVal / rangeInput_cbd[1].max) * 100 + "%";
                    } 

                  });
                });
              </script>


              {% assign counter = counter |  plus: 1 %}
              <details
                id="Details-{{ counter }}-{{ section.id }}"
                class="facets__disclosure-vertical js-filter new_custom_thc"
                data-index="{{ counter }}"
              >
                <summary class="facets__summary caption-large focus-offset">
                  <div>
                    <span class="h6">THC</span>
                    {% render 'theme-icons', icon: 'icon-chevron-down' %}
                  </div>
                </summary>
                <div
                  id="Facet-{{ counter }}-{{ section.id }}"
                  class="facets__display-vertical"
                >
                  {%- liquid
                    assign filter_min_value = thc_value_min | default: 0
                    assign filter_max_value = thc_value_max | default: 100
                    assign filter_range_max = 100
                    assign filter_min_progress = filter_min_value | divided_by: filter_range_max | times: 100.0
                    assign filter_max_progress = filter_max_value | divided_by: filter_range_max | times: 100.0
                  -%}
                  <div class="custom_range_slider thc_main">
                      <div class="new-price-input">
                        <div class="field_custom">
                          <div class="thc__min" data-thc-min="{{filter_min_value}}">{{filter_min_value}}%</div> 
                        </div>
                        <div class="field_custom last">
                          <div class="thc__max" data-thc-max="{{filter_max_value}}">{{filter_max_value}}%</div> 
                        </div>
                      </div>
                      <div class="slider">
                        <div class="progress"></div>
                      </div>
                      <div class="range-input">
                        <input type="range" class="range-min" data-thc-min-range min="{{filter_min_value}}" max="{{filter_max_value}}" value="{{filter_min_value}}" step="1" name="filter.v.thc.gte">
                        <input type="range" class="range-max" data-thc-max-range  min="{{filter_min_value}}" max="{{filter_max_value}}" value="{{filter_max_value}}" step="1" name="filter.v.thc.lte">
                      </div> 
                    </div>
                </div>
              </details>
              <script> 
                let priceGapThc =5;
                const rangeInput_thc = document.querySelectorAll(".thc_main .range-input input"), 
                range_thc = document.querySelector(".thc_main .slider .progress");
                let thc__min = document.querySelector('.thc__min')
                let thc__max = document.querySelector('.thc__max')
                rangeInput_thc.forEach((input) => {
                  input.addEventListener("input", (e) => {
                    let minVal = parseInt(rangeInput_thc[0].value),
                      maxVal = parseInt(rangeInput_thc[1].value);

                    if (maxVal - minVal < priceGapThc) {
                      if (e.target.className === "range-min") {
                        rangeInput_thc[0].value = maxVal - priceGapThc;
                      } else {
                        rangeInput_thc[1].value = minVal + priceGapThc;
                      }
                    } else {
                      thc__min.innerHTML = minVal+'%';
                      thc__max.innerHTML = maxVal+'%';
                      range_thc.style.left = (minVal / rangeInput_thc[0].max) * 100 + "%";
                      range_thc.style.right = 100 - (maxVal / rangeInput_thc[1].max) * 100 + "%";
                    } 

                  });
                });
              </script>

              {% break %}
            {%- endfor -%}


            <noscript>
              <button type="submit" class="facets__button-no-js button button--secondary">
                {{ 'products.facets.filter_button' | t }}
              </button>
            </noscript>
          </div>
        {% endif %}

        {% if results.current_vendor or results.current_type %}
          <input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
        {% endif %}
      </form>
      <div class="filter-button__footer large-up-hide">
        <button
          type="button"
          class="no-js-hidden filter-apply__btn button button--primary"
        >
          {{ 'products.facets.apply' | t }}
        </button>
      </div>
    </facet-filters-form>
  {% endif %}
</div>
