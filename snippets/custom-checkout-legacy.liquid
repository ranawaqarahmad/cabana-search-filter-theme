{% render 'environment-js' %}

<script>
const store_id = '{{ store_id }}';

let metaDataArray = [];
let items = [];
let cart = null;
let coupon = null;
let cannaStoreDetails = null;
const baseServerURL = 'https://app.cannacabana.com/api';
let pickupValue = 'pickup'
const isCustomer = {% if customer %}true{% else %}false{% endif %};
const environment = getEnvironment();

async function getCartItems() {
  showLoader();
  const resp = await fetch('/cart.json');
  cart = await resp.json();
  items = cart.items;
  await getStoreMetaData()
  hideLoader();
  renderAll();
  addCustomerDetails()
}

function addCustomerDetails(){
  const mainSpan = document.querySelector('#customer-details');
  const email = mainSpan.querySelector('#customer-email').textContent;
  const phone =  mainSpan.querySelector('#customer-phone').textContent;
  const first_name =  mainSpan.querySelector('#customer-name').textContent;
  const last_name =  mainSpan.querySelector('#customer-last').textContent;

  section2FirstName.value = first_name
  section2LastName.value = last_name
  section2Email.value = email
  section2MobileNum.value = phone
}

function renderAll() {
  clearAllRenderining();

  renderitems();
  renderReviewSection();
  renderSpecials();
  renderPricingSummary();
  checkForEquivalence()
}

function clearAllRenderining() {
  const divs = ['cart-item-list', 'review-section', 'item-specials'];
  divs.forEach((id) => {
    const div = document.querySelector(`#${id}`);
    div.innerHTML = '';
  });
}

function renderitems() {
  for (const item of items) {
    const metaData = metaDataArray.find((meta) => meta.item_id == item.id);

    if(!metaData.price || metaData.price == '0' || metaData.price == 'N.A.') {
      emptyCart();
      break;
    }

    renderSingleItem(item, metaData);
  }
}

function renderSingleItem(item, metaData) {
  const parentDiv = document.querySelector('#cart-item-list');
  const div = document.createElement('div');

  div.innerHTML = `
    <div class="flex-product responsive-gap custom-padding cart-item responsive-mb" id="item-${item.id}">
      <div class="flex-start">
        <img
          class="product-img"
          src="${item.image}"
          alt="product-assets"
        >
      </div>
      <div class="flex-col w-100">
        <div class="product-block-1 mb-10">Indica</div>
        <div class="weight-600 text-start">${item.product_title}</div>
        <div class="flex-col">
          <p class="margin-0">${item.vendor}</p>
          <p class="margin-0">${item.quantity} x ${item.variant_title} @ $${metaData.price}</p>
          <div class="flex-between-responsive">

            <p class="margin-0 text-center responsive-text-start custom-line-height">
${isCustomer ? `<span class="dollar-box-black">$</span>${
    item.product_title
  } ${getDiscountedPercentage(metaData.price, metaData.compare_at_price)}% Sale (${item.variant_title})
            ` : ''}</p>
            <div class="flex cart-action-btn responsive-text-start">
              <span class="span-button" onclick="handleProductEdit(${item.id})">Edit</span>
              <span class="pointer" onclick="deleteItemHandler(${item.id})">
                <i class="fa-regular fa-trash-can"></i>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
    `;

  parentDiv.appendChild(div);
}

function renderReviewSection() {
  const parentDiv = document.getElementById('review-section');
  for (const item of items) {
    const div = document.createElement('div');
    const metaData = metaDataArray.find((meta) => meta.item_id == item.id);

    div.classList.add('flex-product');
    div.classList.add('gap-5');
    div.setAttribute('id', `review-${item.id}`);

    div.innerHTML = `
        <div class="flex-start">
          <img
            class="product-img"
            src="${item.image}"
            alt="product-assets"
          >
        </div>
        <div class="flex-col w-100">
          <div class="product-block-1 mb-10">Indica</div>
          <div class="product-between">
            <div class="weight-600 text-start">${item.product_title}</div>
            <div class="flex-col">
              <p class="grey margin-0">$${(metaData.price * item.quantity).toFixed(2)}</p>
              <p class="grey margin-0 old-price">$${(metaData.compare_at_price * item.quantity).toFixed(2)}</p>
            </div>
          </div>
          <div class="flex-col">
            <p class="margin-0">${item.vendor}</p>
            <p class="margin-0">${item.quantity} x ${item.variant_title} @ $${metaData.price}</p>
            <p class="margin-0 custom-line-height">
              <span class="dollar-box-black">$</span>
              ${item.product_title} ${getDiscountedPercentage(metaData.price, metaData.compare_at_price)}% Sale (${
      item.variant_title
    })
            </p>
          </div>
        </div>
      `;
    parentDiv.appendChild(div);
  }
}

function renderSpecials() {
  const province = localStorage.getItem('global_province');
  const specialsBlock = document.querySelector('.js-specials');

  if(!isCustomer) {
    return;
  }

  if (specialsBlock) {
    specialsBlock.classList.remove('hidden');
  }
  const parent = document.querySelector('#item-specials');

  for (const item of items) {
    const pTag = document.createElement('p');
    const metaData = metaDataArray.find((meta) => meta.item_id == item.id);

    pTag.classList.add('margin-0');
    pTag.classList.add('custom-green');
    pTag.classList.add('custom-line-height');
    pTag.setAttribute('id', `special-${item.id}`);

    pTag.innerHTML = `<span class="dollar-box-black">$</span>${item.product_title} ${getDiscountedPercentage(
      metaData.price,
      metaData.compare_at_price
    )} % Sale(${item.variant_title})`;

    parent.appendChild(pTag);
  }
}

function parseMetaData() {
  const metaSpans = document.querySelectorAll('.variant-meta-strings');
  const province = localStorage.getItem('global_province');

  metaSpans.forEach((span) => {
    const metaStr = span.getAttribute('data-meta-string');
    const item_id = span.getAttribute('data-item-id');
    const product_id = span.getAttribute('data-product-id');
    const variant_id = span.getAttribute('data-variant-id');
    const arr = metaStr.split(',');

    if (province === 'British Columbia') {
      metaDataArray.push({
        item_id,
        product_id,
        variant_id,
        inventory: +arr[0],
        price: +arr[1],
        compare_at_price: +arr[2],
        size: arr[3],
        tsc: arr[4],
        cbd: arr[5],
        equivalence_value: +arr[6],
        metaStr: metaStr
      });
    } else {
      {% if customer %}
      metaDataArray.push({
        item_id,
        product_id,
        variant_id,
        inventory        : +arr[0],
        price            : +arr[1],
        compare_at_price : +arr[2],
        size             : arr[3],
        tsc              : arr[4],
        cbd              : arr[5],
        equivalence_value: +arr[6],
        metaStr          : metaStr
      });
      {% else %}
      metaDataArray.push({
        item_id,
        product_id,
        variant_id,
        inventory        : +arr[0],
        price            : +arr[2],
        compare_at_price : +arr[2],
        size             : arr[3],
        tsc              : arr[4],
        cbd              : arr[5],
        equivalence_value: +arr[6],
        metaStr          : metaStr
      });
      {% endif %}
    }
  });
}

function checkForEquivalence(){
  const mainDiv = document.querySelector('#equivalence-div');
  const button = mainDiv.querySelector('#checkout-btn-1')
  const errorDiv  =   mainDiv.querySelector('#equivalence-error-message')
  const errorTextTag = errorDiv.querySelector('.error-text')

  const totalSum  = metaDataArray.reduce((total , current) => {
    const lineItem = items.find(item => item.variant_id == current.variant_id )
    if(!lineItem) return total;
    return total += current.equivalence_value * lineItem.quantity
  } , 0)

  if(totalSum > 30){
    button.classList.add('disabled-checkout-btn')
    errorDiv.classList.remove('hidden')
    errorTextTag.innerHTML = `Your bag has <b>${totalSum}g</b> of Cannabis products, but Canna Cabana only allows <b>30g</b> per order.`
  } else {
    button.classList.remove('disabled-checkout-btn')
    errorDiv.classList.add('hidden')
    errorTextTag.innerHTML = ''
  }
  return;
}

function getDiscountedPercentage(price, compare_at_price) {
  const percentage = ((compare_at_price - price) / compare_at_price) * 100;
  return +percentage.toFixed(2);
}

function getTotalPrices() {
  let cart_subtotal = 0;
  let total_non_member_price = 0;
  let sales_tax = 0;
  let total_price = 0;
  let discount = 0
  let sales_tax_percentage = 0
  const delivery_charges = 9.99

  for (const item of items) {
    const metaData = metaDataArray.find((meta) => meta.item_id == item.id);
    const { quantity } = item;

    cart_subtotal += metaData.price * quantity;
    total_non_member_price += metaData.compare_at_price * quantity;
  }

  if(coupon){
    const {discount_type, discount_value} = coupon;
    if(discount_type == 'percentage'){
      discount = +(+discount_value / 100 * cart_subtotal).toFixed(2)
    } else {
      discount = +discount_value
    }
  }

  if(cannaStoreDetails && cannaStoreDetails.meta && Array.isArray(cannaStoreDetails.meta)){
    const salesTaxMeta  = cannaStoreDetails.meta.find(m => m.key === "sales_tax");
    if(salesTaxMeta){
      sales_tax_percentage = +salesTaxMeta.value;
      sales_tax = +(+sales_tax_percentage / 100 * cart_subtotal).toFixed(2)
    }
  }

  total_price = +(cart_subtotal + sales_tax - discount).toFixed(2)

  if(pickupValue === 'delivery'){
    total_price = +(total_price + delivery_charges).toFixed(2)
  }

  return {
    cart_subtotal: cart_subtotal.toFixed(2),
    total_saving: (total_non_member_price - cart_subtotal).toFixed(2),
    sales_tax : sales_tax.toFixed(2),
    total_price : total_price.toFixed(2),
    discount : discount.toFixed(2),
    actual_price: (cart_subtotal + sales_tax).toFixed(2),
    sales_tax_percentage,
    delivery_charges : delivery_charges.toFixed(2)
  };
}

function renderPricingSummary() {
  const { cart_subtotal, total_saving, sales_tax, total_price , discount , delivery_charges} = getTotalPrices();
  const pricingSummarys = document.querySelectorAll('.pricing-summary');
  const reviewCart = document.querySelector('#review-cart-subtotal');

  const deliveryHTML = `
    <div class="flex-between">Delivery Charges</div>
    <div class="flex-between align-right">$${delivery_charges}</div>
    `

  pricingSummarys.forEach((summary) => {
    summary.innerHTML = `
        <div class="flex-between">Items (${cart.item_count})</div>
        <div class="flex-between align-right">$${cart_subtotal}</div>
        <div class="flex-between">Estimated savings</div>
        <div class="flex-between align-right">-$${total_saving}</div>
        <div class="flex-between">Estimated service fee</div>
        <div class="flex-between align-right">
          <span class="free"> Free </span>
        </div>
        <div class="flex-between">Estimated sales tax</div>
        <div class="flex-between align-right">$${sales_tax}</div>
        <div class="flex-between">Discount on coupon</div>
        <div class="flex-between align-right" data-check="${pickupValue}">$${discount}</div>
        ${pickupValue === 'delivery' ? deliveryHTML : ''}

        <h2>Estimated total</h2>
        <h2 class="align-right">$${total_price}</h2>
        `;
  });

  reviewCart.innerHTML = `$${total_price}`;
}

function showLoader() {
  document.querySelector('#loading').classList.remove('hidden');
}

function hideLoader() {
  document.querySelector('#loading').classList.add('hidden');
}

function formateDate(date = new Date()) {
  const month = date.getMonth() + 1;
  const day = date.getDate();
  const year = date.getFullYear();
  const hours = date.getHours();
  const minites = date.getMinutes();
  const seconds = date.getSeconds();

  return `${year}-${month}-${day} ${hours}:${minites}:${seconds}`;
}

async function getStoreMetaData(){
  try {
    let requestId = 'a5e61f30-66f4-11ef-94c6-4dd8d5695ca2';

    if (environment === 'dev') {
      requestId = '828d9ca0-5f17-11ef-ae1c-c39bc88117ff';
    }
    const deliveryBTN = document.querySelector('#order-delivery');
    const queryParams = new URLSearchParams({
      requestId: requestId,
      bodyEmbedded: JSON.stringify({
        key : [ 'sales_tax' , 'payment_options' , 'delivery_option' , 'delivery_hours']
      }),
