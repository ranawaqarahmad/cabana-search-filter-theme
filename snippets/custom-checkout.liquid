<script>
const store_id = localStorage.getItem('global_store_id');

let metaDataArray     = [];
let items             = [];
let cart              = null;
let coupon            = null;
let cannaStoreDetails = null;
const baseServerURL   = 'https://app.cannacabana.com/api';
let pickupValue       = 'pickup';

async function getAccessToken() {
  let accessToken = localStorage.getItem('canna_access_token') ?? null;
  if (!accessToken) {
    try {
      const response = await fetch(`${baseServerURL}/oauth/token`, {
        method : 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body   : new URLSearchParams({
          client_id    : '7',
          client_secret: 'dqo3pUrSPyN0ONslDAzw1oHaxXs5KZ3D38DcNqLa',
          grant_type   : 'client_credentials',
        }),
      });
      if (!response.ok) {
        throw new Error('Failed to retrieve access token');
      }
      const data  = await response.json();
      accessToken = data.access_token;
      localStorage.setItem('canna_access_token', accessToken);
    } catch (error) {
      console.error('Error:', error);
    }
  }

  return accessToken;
}

async function getCartItems() {
  showLoader();
  const resp = await fetch('/cart.json');
  cart       = await resp.json();
  items      = cart.items;
  await getStoreMetaData();
  hideLoader();
  renderAll();
  addCustomerDetails();
}

function addCustomerDetails() {
  const mainSpan   = document.querySelector('#customer-details');
  const email      = mainSpan.querySelector('#customer-email').textContent;
  const phone      = mainSpan.querySelector('#customer-phone').textContent;
  const first_name = mainSpan.querySelector('#customer-name').textContent;
  const last_name  = mainSpan.querySelector('#customer-last').textContent;

  section2FirstName.value = first_name;
  section2LastName.value  = last_name;
  section2Email.value     = email;
  section2MobileNum.value = phone;
}

function renderAll() {
  clearAllRenderining();

  renderitems();
  renderReviewSection();
  renderSpecials();
  renderPricingSummary();
  checkForEquivalence();
  checkForEquivalenceLoad();
}

function clearAllRenderining() {
  const divs = ['cart-item-list', 'review-section', 'item-specials'];
  divs.forEach((id) => {
    const div     = document.querySelector(`#${id}`);
    div.innerHTML = '';
  });
}

function renderitems() {
  for (const item of items) {
    const metaData = metaDataArray.find((meta) => meta.item_id == item.id);
    renderSingleItem(item, metaData)
      .then(() => {
        grabSingleItemVars();
      })
      .catch(error => {
        console.error('Error rendering item:', error);
      });
  }
}

function renderSingleItem(item, metaData, isReview = false) {
  return new Promise((resolve, reject) => {
    try {
      const parentDiv       = document.querySelector('#cart-item-list');

      const div = document.createElement('div');

      const isIncrementDisabled = item.quantity >= metaData.inventory ? 'disabled-checkout-btn' : '';
      const minAttribute        = item.quantity_rule?.min !== undefined ? `min="${item.quantity_rule.min}"` : '';
      const maxAttribute        = item.quantity_rule?.max !== undefined ? `max="${item.quantity_rule.max}"` : '';
      const stepAttribute       = item.quantity_rule?.increment !== undefined ? `step="${item.quantity_rule.increment}"` : '';

      div.innerHTML = `
        <div class="cart-items">
          <div class="cart-item mgb-small" id="item-${item.id}">
            <div class="cart-item__flex-container">
              <div class="cart-item__media-details-container">
                <div class="cart-item__media">
                  <div class="product-img cart-item__image-container gradient global-media-settings">
                    <img
                      src="${item.image}"
                      class="cart-item__image"
                      alt="${item.image.alt}"
                      loading="lazy"
                      width="87"
                      height="87"
                    >
                  </div>
                </div>
                <div class="cart-item__details">
                  <a href="${item.url}" class="cart-item__name h6 break">
                    ${item.product_title}
                  </a>
                  <div class="product-options">
                    <span>${item.variant_title}</span>
                  </div>
                  <span class="product-options">{{ 'products.product.by' | t }} ${item.vendor}</span>
                </div>
              </div>
              <div class="items_qty_and_price cart-item__qty-and-price-container">
                <div class="qty_left">
                  <div class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                    <quantity-popover>
                      <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                        <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                          {%- if has_qty_rules or has_vol_pricing -%}
                            <button
                              type="button"
                              aria-expanded="false"
                              class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide no-js-hidden"
                            >
                              {%- render 'theme-icons', icon: 'icon-minus' -%}
                            </button>
                          {%- endif -%}
                          <quantity-input class="quantity cart-quantity">
                            <button id="decrementBtn" class="quantity__button no-js-hidden" name="minus" type="button" onclick="decrementQuantity(event, ${item.id}, ${metaData.inventory})">
                              <span class="visually-hidden">
                                {{- 'products.product.quantity.decrease_checkout' | t -}} ${item.title}
                              </span>
                              {%- render 'theme-icons', icon: 'icon-minus' -%}
                            </button>
                            <input
                              id="modal-order-quantity"
                              class="order-quantity quantity__input"
                              data-quantity-variant-id="${item.variant_id}"
                              type="number"
                              name="updates[]"
                              value="${item.quantity}"
                              onchange="
                                if (this.value > ${metaData.inventory}) {
                                  alert('Quantity exceeds available inventory.');
                                  this.value = ${item.quantity};
                                  return;
                                }
                                handleProductEdit(${item.id}, null, event, ${metaData.inventory});
                              "
                              data-cart-quantity=""
                              ${minAttribute}
                              ${maxAttribute}
                              ${stepAttribute}
                              aria-label="{{ 'products.product.quantity.input_label_checkout' | t }}" ${item.title}
                            >
                            <button id="incrementBtn" class="quantity__button no-js-hidden ${isIncrementDisabled}" name="plus" type="button" onclick="incrementQuantity(event, ${item.id}, ${metaData.inventory})">
                              <span class="visually-hidden">
                                 {{- 'products.product.quantity.increase_checkout' | t -}} ${item.title}
                              </span>
                              {%- render 'theme-icons', icon: 'icon-plus' -%}
                            </button>
                          </quantity-input>
