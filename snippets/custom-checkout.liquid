function formateDate(date = new Date()) {
  const month   = date.getMonth() + 1;
  const day     = date.getDate();
  const year    = date.getFullYear();
  const hours   = date.getHours();
  const minites = date.getMinutes();
  const seconds = date.getSeconds();

  return `${year}-${month}-${day} ${hours}:${minites}:${seconds}`;
}

async function getStoreMetaData() {
  try {
    const deliveryBTN = document.querySelector('#order-delivery');

    const token = await getAccessToken();
    const resp  = await fetch(`${baseServerURL}/ihj-store/${store_id}/get`, {
      method : 'POST',
      headers: {
        'Content-Type' : 'application/json',
        'Authorization': `Bearer ${token}`
      },
      body   : JSON.stringify({
        key: ['sales_tax', 'payment_options', 'delivery_option', 'delivery_hours']
      })
    });

    const data        = await resp.json();
    const details     = data.data;
    cannaStoreDetails = details;

    if (details.meta && Array.isArray(details.meta)) {
      const deliveryOption = details.meta.find(opt => opt.key === 'delivery_option');
      if (deliveryOption && deliveryOption.value === 'enabled') {
        deliveryBTN.classList.remove('d-none');
      }
    }

  } catch (e) {
    console.error(e);
  }
}

