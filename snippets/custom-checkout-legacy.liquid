async function generateMonerisTicket(orderDetails) {
  showLoader();

  const orderPayload = getOrderPayload();
  let requestId = '413fbe30-66f2-11ef-88c9-6bd2884ff497';

  if (environment === 'dev') {
    requestId = 'a2afe440-4f57-11ef-a830-47ad45c60954';
  }

  orderPayload.items.forEach(item => {
    delete item.product_description;
  });

  const queryParams = new URLSearchParams({
    requestId: requestId,
    bodyEmbedded: JSON.stringify({
      price             : orderDetails.price,
      store_id          : orderDetails.store_id,
      line_items        : orderPayload.line_items,
      shopify_line_items: orderPayload.items,
      longitude         : localStorage.getItem('latitude_a'),
      latitude          : localStorage.getItem('longitude_a')
    })
  });

  try {
    const resp = await fetch('/apps/apiease/integration/caller/call?' + queryParams);
    const responseData = await resp.json();
    const data = responseData.data;
    if (!data.success) {
      // empty the cart and
      const isArray = data.data && Array.isArray(data.data);

      // todo:: filter the items to remove
      if (isArray && data.data.length !== orderPayload.items.length) {
        const itemsToRemove = orderPayload.items.filter((i) => {
          const exist = data.data.find((item) => item.id === i.id);
          return !exist;
        });

        const ids = itemsToRemove.map((i) => i.id);

        for (const lineItemId of ids) {
          await deleteItemHandler(lineItemId);
        }

        handleStepHeader(3);
        handleStepHeader(4);

        itemsToRemove.forEach((i) => {
          Toastify({
            text: `"${i.title}"  \n is removed from the cart because of unavailability.`,
            duration: 5000,
            close: true,
            gravity: 'top',
            position: 'right',
            stopOnFocus: true,
            style: { background: '#f32735' },
            offset: { y: 50 },
          }).showToast();
        });
      }

      if (isArray && data.data.length === 0) {
        Toastify({
          text: 'None of the items is available so we remove all the items from the cart.',
          duration: 5000,
          close: true,
          gravity: 'top',
          position: 'right',
          stopOnFocus: true,
          style: { background: '#f32735' },
          offset: { y: 50 },
        }).showToast();
        await emptyCart();
        setTimeout(()=>{
          window.location.reload();
        }, 3000);

        return;
      }
    } else {
      // success case
      checkoutSection2.classList.add('hidden');
      checkoutSection3.classList.remove('hidden');

      const moneris_ticket = data.data.ticket;
      let checkoutMode = 'prod';

      if (environment === 'dev') {
        checkoutMode = 'qa';
      }

      items = data.data.shopify_line_items;
      myCheckout.setMode(checkoutMode);
      myCheckout.startCheckout(moneris_ticket);
      document.querySelector('header').style.display = 'none';

      window.scrollTo(0, 0);
      // redirect to the home page after 20 minutes
      setTimeout(() => {
          alert("Moneris session has expired. Try again please !")
          window.location.href = "/cart"
        },
        15 * 60 * 10000
      )
    }
  } catch (e) {
    Toastify({
      text: 'Server Error',
      duration: 5000,
      close: true,
      gravity: 'top',
      position: 'right',
      stopOnFocus: true,
      style: { background: '#f32735' },
      offset: { x: 50, y: 100 },
    }).showToast();
  } finally {
    hideLoader();
  }
}

async function completeOrderCOD(orderDetails) {
  showLoader();

  let requestId = '86352d20-66f4-11ef-94c6-4dd8d5695ca2';

  if (environment === 'dev') {
    requestId = 'e8abcd60-5f15-11ef-ae1c-c39bc88117ff';
  }

  const queryParams = new URLSearchParams({
    requestId: requestId,
    bodyEmbedded: JSON.stringify(orderDetails),
  });

  const resp = await fetch('/apps/apiease/integration/caller/call?' + queryParams);
  const responseData = await resp.json();
  const data = responseData.data;

  if (data.success) {
    orderSuccessHandler(true);
  } else {
    console.log(data);
    alert('SOME ERROR IN {completeOrderCOD}');
  }
  hideLoader();
}

async function orderCompletedByOnlinePayment(e) {
  const event = JSON.parse(e);
  console.log('EVENT#############', event);
  const { handler, ticket, response_code } = event;

  if (response_code != '001') {
    return console.log('TRANSACTION FAILED');
  }

  showLoader();

  let location_dynamics = []

  if(navigator.geolocation){
    navigator.geolocation.getCurrentPosition((position)=>{
      location_dynamics.push(position.coords.longitude)
      location_dynamics.push(position.coords.latitude)
    })
  }

  try {
    const payload = getOrderPayload();
    let requestId = '42904820-66f4-11ef-94c6-4dd8d5695ca2';

    if (environment === 'dev') {
      requestId = 'c8c97270-5f12-11ef-ae1c-c39bc88117ff';
    }

    payload.items.forEach(item => {
      delete item.product_description;
    });

    const queryParams = new URLSearchParams({
      requestId: requestId,
      bodyEmbedded: JSON.stringify({
        ...payload,
        moneris_checkout_ticket: ticket,
        moneris_event: handler,
        ticket_id: event.ticket,
        store_id,
        longitude:localStorage.getItem('latitude_a'),
        latitude:localStorage.getItem('longitude_a')
      }),
    });

    const resp = await fetch('/apps/apiease/integration/caller/call?' + queryParams);
    const responseData = await resp.json();
    const data = responseData.data;

    if (data.success == true) {
      orderSuccessHandler();
    } else {
      orderCancelHandler();
    }

  } catch(e){
    console.log("SOME ERROR IN get-receipt" , e)
    orderCancelHandler();
  } finally {
    hideLoader();
    document.querySelector('header').classList.remove('hidden')
  }
}

async function orderSuccessHandler(is_cod = false) {
  if (is_cod) {
    checkoutSection2.classList.add('hidden');
    checkoutSection3.classList.add('hidden');
    checkoutSection4.classList.remove('hidden');
  } else {
    checkoutSection3.classList.add('hidden');
    checkoutSection4.classList.remove('hidden');
  }

  await emptyCart();

  setTimeout(()=>{
    window.location.href = '/pages/thank-you';
  }, 5000);
}

function orderCancelHandler() {
  myCheckout.closeCheckout(' ');
  checkoutSection3.classList.add('hidden');
  checkoutSection5.classList.remove('hidden');
}

async function cancelOrder(e) {
  console.log('###################### - myCancelTransaction', e);
  document.querySelector('header').style.display = 'block';
  window.location.reload();
}

function getOrderPayload() {
  const { total_price, actual_price, discount, sales_tax_percentage, sales_tax } = getTotalPrices();

  var tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);

  let delivery_date = '';

  if (deliveryTime.value) {
    delivery_date =  deliveryTime.value
  }

  return {
    pickup_day: pickupDay.value === 'today' ? formateDate(new Date()) : formateDate(tomorrow),
    instructions: specialInstructions.value,
    first_name: section2FirstName.value,
    last_name: section2LastName.value,
    dob: section2BirthDate.value,
    email: section2Email.value,
    phone: section2MobileNum.value,
    is_payment_online: is_payment_online,
    items: items,
    customer_id: __st.cid,
    price: total_price,
    store_id,
    disount_amount: discount,
    coupon_id: coupon ? coupon.id : null,
    actual_price: actual_price,
    sales_tax_percentage: sales_tax_percentage,
    sales_tax_price: sales_tax,
    is_delivery_enabled: pickupValue === 'delivery',
    external_identifier: 'cc_',
    delivery_address: {
      line_1: checkoutDeliveryAddress.value,
      line_2: checkoutDeliveryFloor.value,
      city: checkoutDeliveryCity.value,
      state: checkoutDeliveryState.value,
      zip_code: checkoutDeliverypostalCode.value,
      country: 'Canada',
      delivery_date,
    },
    line_items: items.map((item) => {
      const i = metaDataArray.find((meta) => meta.item_id == item.id);

      return {
        sku: item.sku,
        quantity: item.quantity,
        price: i.price,
        meta: i.metaStr,
        gt_item_id: item.gt_item_id,
      };
    }),
  };
}

async function emptyCart() {
  const resp = await fetch(window.Shopify.routes.root + 'cart/clear.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({}),
  });

  await resp.json();

  const span = document.querySelector('.site-header-cart--count.visible');
  if (span) {
    span.setAttribute('data-header-cart-count', 0);
  }
  return;
}

function initializeMonerisCheckout() {
  myCheckout.setCheckoutDiv('monerisCheckout');
  myCheckout.setCallback('page_loaded', myPageLoad);
  myCheckout.setCallback('page_closed', myPageClosed);
  myCheckout.setCallback('payment_submitted', myPaymentSubmitted);

  myCheckout.setCallback('cancel_transaction', cancelOrder);
  myCheckout.setCallback('error_event', cancelOrder);

  myCheckout.setCallback('payment_receipt', orderCompletedByOnlinePayment);
  myCheckout.setCallback('payment_complete', orderCompletedByOnlinePayment);
}

const handlePromoClick = () => {
  iconTransform.classList.toggle('fa-rotate-180');
  promoCodeDiv.classList.toggle('hidden');
};

initializeMonerisCheckout()
initializeValues();
//initializePhoneValidator();
</script>
