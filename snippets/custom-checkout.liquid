async function generateMonerisTicket(orderDetails) {
  showLoader();

  const token        = await getAccessToken();
  const orderPayload = getOrderPayload();
  try {
    const resp = await fetch(`${baseServerURL}/checkout/get-ticket`, {
      method : 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization : `Bearer ${token}`,
      },
      body   : JSON.stringify({
        price             : orderDetails.price,
        store_id          : orderDetails.store_id,
        line_items        : orderPayload.line_items,
        shopify_line_items: orderPayload.items,
        longitude         : localStorage.getItem('latitude_a'),
        latitude          : localStorage.getItem('longitude_a')
      }),
    });

    const data = await resp.json();

    if (!data.success) {
      // empty the cart and
      const isArray = data.data && Array.isArray(data.data);

      // todo:: filter the items to remove
      if (isArray && data.data.length !== orderPayload.items.length) {
        const itemsToRemove = orderPayload.items.filter((i) => {
          const exist = data.data.find((item) => item.id === i.id);
          return !exist;
        });

        const ids = itemsToRemove.map((i) => i.id);

        for (const lineItemId of ids) {
          await deleteItemHandler(lineItemId);
        }

        handleStepHeader(3);
        handleStepHeader(4);

        itemsToRemove.forEach((i) => {
          Toastify({
            text       : `"${i.title}"  \n is removed from the cart because of unavailability.`,
            duration   : 5000,
            close      : true,
            gravity    : 'top',
            position   : 'right',
            stopOnFocus: true,
            style      : {background: '#f32735'},
            offset     : {y: 50},
          }).showToast();
        });
      }

      if (isArray && data.data.length === 0) {
        Toastify({
          text       : 'None of the items is available so we remove all the items from the cart.',
          duration   : 5000,
          close      : true,
          gravity    : 'top',
          position   : 'right',
          stopOnFocus: true,
          style      : {background: '#f32735'},
          offset     : {y: 50},
        }).showToast();
        await emptyCart();
        setTimeout(() => {
          window.location.reload();
        }, 3000);

        return;
      }
    } else {
      // success case
      checkoutSection2.classList.add('d-none');
      checkoutSection3.classList.remove('d-none');

      const moneris_ticket = data.data.ticket;
      items                = data.data.shopify_line_items;
      myCheckout.setMode('prod');
      myCheckout.startCheckout(moneris_ticket);
      document.querySelector('header').style.display = 'none';

      window.scrollTo(0, 0);
      // redirect to the home page after 20 minutes
      setTimeout(
        () => {
          alert('Moneris session has expired. Try again please !');
          window.location.href = '/cart';
        },
        15 * 60 * 10000
      );
    }
  } catch (e) {
    Toastify({
      text       : 'Server Error',
      duration   : 5000,
      close      : true,
      gravity    : 'top',
      position   : 'right',
      stopOnFocus: true,
      style      : {background: '#f32735'},
      offset     : {x: 50, y: 100},
    }).showToast();
  } finally {
    hideLoader();
  }
}

