<style>
  h2 {
    font-size: 24px !important;
  }

  #review-section {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .delivery-options-tabs {
    display: flex;
    flex-direction: row;
    overflow: auto hidden;
    position: relative;
    scrollbar-width: none;
    width: 100%;
  }

  .delivery-option {
    background: transparent;
    border-width: 0px;
    cursor: pointer;
    pointer-events: initial;
    width: auto;
    flex-shrink: 0;
    overflow: hidden;
    transition: all 250ms ease 0s;
    text-align: center;
    padding: 16px 24px;
    -webkit-box-flex: 1;
    flex-grow: 1;
    max-width: none;
  }


  .checkout-conditions {
    color: #878787;
    line-height: 24px;
    font-size: 14px;
    font-weight: 500;
    max-width: 330px;
    min-width: 230px;
    width: auto;
  }


  .delivery-option-unselected {
    box-shadow: rgb(218, 218, 218) 0px -1px inset;
  }

  .delivery-option-selected {
    box-shadow: rgb(243, 39, 53) 0px -2px inset;
  }

  .checkout-div-v2 {
    border: 1px solid rgb(218, 218, 218);
    border-radius: 24px;
  }

  .checkout-div-content {
    padding: 24px;
  }

  .text-underline {
    text-decoration: underline;
  }

  .dollar-box-black {
    color: #fff;
    background-color: #1a3c34;
    padding: 1px 5px;
    border-radius: 1px;
    font-size: 12px;
    margin-right: 8px;
  }

  .custom-green {
    color: #1a3c34;
  }

  #item-specials {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  #section-center {
    display: flex;
    justify-content: center;
  }

  .capitalize {
    text-transform: uppercase;
  }

  .custom-checkout-section {
    width: auto;
  }

  .f-14 {
    font-size: 14px;
  }

  .disabled-checkout-btn {
    opacity: 0.3 !important;
    pointer-events: none;
  }

  .custom-checkout>textarea {
    padding: 12px;
    color: rgb(14, 14, 14);
    border-radius: 16px;
    display: block;
    appearance: none;
    border: 1px solid rgb(218, 218, 218);
    resize: vertical;
    font-size: 16px;
  }

  .custom-checkout>textarea:focus-visible {
    outline: rgb(243, 39, 53) solid 2px;
  }

  .main-checkout {
    display: grid;
    padding: 0 10px;
    gap: 24px;
    width: 100%;
    grid-template-columns: 70% 30%;
  }

  .checkout-div {
    padding: 24px;
    border: 1px solid rgb(218, 218, 218);
    border-radius: 24px;
  }

  .inputs-grid {
    margin-top: 16px;
    display: grid;
    gap: 24px 32px;
  }

  .flex {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .flex-product {
    display: flex;
    gap: 24px;
  }

  .flex-end {
    display: flex;
    justify-content: end;
    gap: 5px;
  }

  .align-start {
    align-items: start !important;
  }

  .active {
    box-shadow: rgba(160, 161, 161, 0.5) 0px 4px 15px 0px;
  }

  .promo-code-input-div {
    margin-bottom: 24px;
    margin-top: 16px;
    display: flex;
    /*border: 1px solid rgb(218, 218, 218);*/
    border-radius: 24px;
    align-items: stretch;
    overflow: hidden;
    /* height: 4px; */
  }

  .w-30 {
    width: 30%;
  }

  .mt-24 {
    margin-top: 24px;
  }

  .promo-code-input-div>input[type='text'] {
    width: 100%;
    height: 48px;
    border-radius: 24px;
    padding: 0 15px;
    border: 1px solid rgb(218, 218, 218);
  }

  .promo-code-input-div>button {
    height: 50px;
  }

  .content {
    padding: 24px 32px 40px 45px;
  }

  .flex-col {
    display: flex;
    flex-direction: column;
    justify-content: start;
  }

  .modal-items-center {
    margin-bottom: 0px;
    margin-top: 16px;
    padding: 32px;
    border: none;
    border-radius: 24px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: center;
  }

  .align-center {
    align-items: center !important;
  }

  .flex-start {
    display: flex;
    justify-content: start;
    align-items: start;
  }

  .gap-20 {
    gap: 24px;
  }

  .gap-5 {
    gap: 5px !important;
  }

  .f-16 {
    font-size: 16px;
    font-weight: 500;
    margin: 0;
  }

  .flex-between {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .product-between {
    display: flex;
    justify-content: space-between;
  }

  .width-50,
  .flex-between>p {
    line-height: 25px;
  }

  .width-50 {
    width: 50%;
  }

  .number-item {
    border: 1px solid #000;
    height: 28px;
    width: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mb-40 {
    margin-bottom: 40px;
  }

  .custom-padding {
    padding: 0px 16px;
  }

  .span-button {
    color: rgb(14, 14, 14);
    cursor: pointer;
    display: inline-block;
    height: fit-content;
    outline: none;
    width: fit-content;
    background-image: linear-gradient(to right, rgb(135, 135, 135) 50%, transparent 50%);
    background-position: center bottom;
    background-repeat: repeat-x;
    background-size: 4px 1px;
    transition: all 250ms ease 0s;
  }

  a.span-button {
  {
  % comment %
  }

    text-decoration: none;

  {
  % endcomment %
  }

    background: none;
    font-size: 10px;
    margin-left: 4rem;
  }

  .custom-select {
    padding: 12px 40px 12px 16px;
    border: 1px solid rgb(218, 218, 218);
    color: rgb(14, 14, 14);
    appearance: none;
    background: transparent;
    cursor: pointer;
    border-radius: 16px;
    width: auto;
    max-width: 400px;
  }

  .custom-select:focus-visible {
    outline: rgb(243, 39, 53) solid 2px;
  }

  .mt-10 {
    margin-top: 10px;
  }

  .mb-10 {
    margin-bottom: 10px;
  }

  .weight-600 {
    font-weight: 600;
  }

  .w-100 {
    width: 100% !important;
  }

  .store-logo {
    border-radius: 4px;
    width: 50px;
    height: 50px;
  }

  .custom-label {
    font-size: 16px;
    line-height: 24px;
  }

  .pl-26 {
    padding-left: 26px;
  }

  .grey {
    color: #878787;
  }

  .pt-10 {
    padding-top: 10px;
  }

  .custom-hr {
    margin: 20px 0;
    height: 0px;
    border-width: 1px 0px 0px;
    border-top-style: solid;
    border-top-color: rgb(218, 218, 218);
  }

  .pointer {
    cursor: pointer;
  }

  .align-right {
    display: block;
    text-align: right;
  }

  .free {
    padding: 2px 8px;
    background-color: rgb(26, 60, 52);
    color: rgb(255, 255, 255);
    box-shadow: rgba(0, 0, 0, 0.16) 0px 4px 15px 0px;
    border-radius: 4px;
  }

  .summary-grid {
    display: grid;
    row-gap: 15px;
    grid-template-columns: auto auto;
    width: 100%;
  }

  .h-max {
    height: max-content;
  }

  .hidden-content {
    display: none;
  }

  .custom-button {
    border-radius: 24px;
    cursor: pointer;
    height: 48px;
    text-align: center;
    text-decoration: none;
    transition: all 250ms ease 0s;
    padding-left: 16px;
    padding-right: 16px;
    background: rgb(243, 39, 53);
    border: 2px solid rgb(243, 39, 53);
    color: rgb(255, 255, 255);
  }

  .margin-0 {
    margin: 2px;
  }

  .text-start {
    text-align: start;
  }

  .text-center {
    text-align: center;
  }

  .custom-promo-icon {
    border: 2px solid black;
    border-radius: 50%;
    padding: 3px 5px 1px 5px;
  }

  .product-img {
    width: auto;
    height: 60px;
    object-fit: cover;
    border: 1px solid rgb(218, 218, 218);
    border-radius: 24px;
  }

  .old-price {
    color: rgb(135, 135, 135);
    text-decoration: line-through;
  }

  .product-block-1 {
    background-color: rgb(255, 255, 255);
    border: 1px solid rgb(14, 14, 14);
    color: rgb(14, 14, 14);
    font-family: 'Source Sans Pro', Helvetica, Arial, sans-serif;
    padding: 2px 4px;
    font-weight: 400;
    text-transform: none;
    font-size: 15px;
    line-height: 24px;
    text-align: center;
    border-radius: 3px;
    width: fit-content;
  }

  .custom-checkout>input[type='checkbox'] {
    width: 18px;
    height: 18px;
    border-radius: 13px;
    accent-color: #f32735;
    border: 1px solid rgb(218, 218, 218);
  }

  .custom-checkout>input[type='radio'] {
    width: 18px;
    height: 18px;
    accent-color: #f32735;
    border: 1px solid rgb(218, 218, 218);
  }

  .inputs-grid-item>input[type='text'],
  .inputs-grid-item>input[type='email'],
  .inputs-grid-item>input[type='date'],
  .inputs-grid-item>input[type='tel'] {
    padding: 8px 0px;
    width: 100%;
    display: block;
    outline: none;
    background: transparent;
    color: rgb(14, 14, 14);
    border: 0px;
    font-size: 16px;
    border-bottom: 1px solid rgb(218, 218, 218);
  }

  .inputs-grid-item>input[type='text']:focus,
  .inputs-grid-item>input[type='email']:focus,
  .inputs-grid-item>input[type='date']:focus,
  .inputs-grid-item>input[type='tel']:focus {
    border-bottom: 2px solid #f32735;
  }

  .input-label {
    font-size: 14px;
  }

  .red-color {
    color: #f32735;
  }

  .modal-container {
    position: fixed;
    top: 0;
    left: 0;

    z-index: 10;

    display: none;
    justify-content: center;
    align-items: center;

    width: 100%;
    height: 100%;

    background: rgba(0, 0, 0, 0.4);
    inset: 0px;
    transition: opacity 200ms ease 0s;
    z-index: 99999999;
  }

  .custom-modal {
    position: relative;
    background: #fff;
    width: 90%;
    max-width: 900px;
    height: 60%;
    border-radius: 0.8rem;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 24px;
    overflow: hidden;
  }

  .modal-header {
    padding: 16px 24px 0;
  }

  .modal-padding {
    padding: 25px 40px;
  }

  .cart-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .responsive-flex {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .flex-between-responsive {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .custom-line-height {
    line-height: 20px;
  }

  @media only screen and (max-width: 425px) {
    .checkout-div {
      padding: 12px;
    }

    .responsive-mb {
      margin-bottom: 20px;
    }

    .responsive-gap {
      gap: 10px;
    }

    .flex-between-responsive {
      flex-direction: column;
      align-items: start;
    }

    .modal-padding {
      padding: 17px 15px;
    }

    .content {
      padding: 10px 0px 10px 0px;
    }

    .inputs-grid {
      display: flex;
      flex-direction: column;
      padding: 10px;
    }

    .inputs-grid-item {
      min-width: 250px;
      max-width: 350px;
      width: 100%;
    }

    .modal-header {
      padding: 16px 15px 0;
    }

    .responsive-text-start {
      text-align: start !important;
    }

    .responsive-flex {
      flex-direction: column;
      align-items: start;
    }

    .custom-checkout-section {
      padding: 10px !important;
    }

    .custom-padding {
      padding: 0px 8px;
    }

    h2 {
      font-size: 20px !important;
    }

    .cart-header-flex {
      flex-direction: column;
      align-items: start;
    }

    .custom-checkout-section {
      padding: 0px;
    }
  }

  @media screen and (max-width: 784px) {
    .main-checkout {
      padding: 0 10px;
      display: flex;
      flex-direction: column;
    }

    .custom-checkout-section {
      padding: 20px;
    }
  }

  @media screen and (max-width: 375px) {
    .content {
      padding: 0;
    }
  }

  {% comment %} @media only screen and (min-width: 1000px) {
    .custom-checkout-section-1,
    .custom-checkout-section-2,
    .custom-checkout-section-3,
    .custom-checkout-section-4{
      width: 860px;
    }
  } {% endcomment %}

  @media screen and (max-width: 375px) {
    .content {
      padding: 0;
    }

    .inputs-grid {
      display: flex;
      flex-direction: column;
    }
  }

  .hidden {
    display: none !important;
  }

  .loading {
    height: 100%;
    width: 100%;
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    background: #ffffffab;
    z-index: 11111111111111;
    display: grid;
    place-items: center;
  }

  .error-message .error-text {
    color: rgb(14, 14, 14);
  }

  .error-message .error-title {
    color: rgb(255, 51, 51);
    font-weight: 600;
  }

  .inputs-grid-item.phone-grid{
    flex-direction: column;
  }

  .inputs-grid-item.phone-grid label{
    margin-bottom: 10px;
  }

  .inputs-grid-item.phone-grid input {
    width: 100%;
    border-left-color: transparent;
    border-top-color: transparent;
    border-right-color: transparent;
    border-bottom: 1px solid rgb(218, 218, 218);
    padding-bottom: 6px;
  }

  .inputs-grid-item.phone-grid input:focus{
    border-bottom: 2px solid #f32735;
  }
</style>

<div class="hidden">
  {% for item in cart.items %}
    <span
      class="variant-meta-strings"
      id="line-item-{{ item.id }}"
      data-item-id="{{ item.id }}"
      data-product-id="{{ item.product.id }}"
      data-variant-id="{{ item.variant.id }}"
      data-meta-string="{{ item.variant.metafields.jane[store_id] }}"
    >
    </span>
  {% endfor %}
</div>

<div class="loading" id="loading">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    style="margin: auto; background: rgba(255, 255, 255, 0); display: block;"
    width="200px"
    height="200px"
    viewBox="0 0 100 100"
    preserveAspectRatio="xMidYMid"
  >
    <circle cx="50" cy="50" fill="none" stroke="#f32735" stroke-width="2" r="10" stroke-dasharray="47.12388980384689 17.707963267948966">
      <animateTransform attributeName="transform" type="rotate" repeatCount="indefinite" dur="1s" values="0 50 50;360 50 50" keyTimes="0;1"></animateTransform>
    </circle>
  </svg>
</div>

<span id="customer-details" class="hidden">
  <h1 id="customer-email">{{ customer.email }}</h1>
  <h1 id="customer-phone">{{ customer.phone }}</h1>
  <h1 id="customer-name">{{ customer.first_name }}</h1>
  <h1 id="customer-last">{{ customer.last_name }}</h1>
</span>

<section
  id="section-center"
  class="custom-checkout-section"
  style="margin-top:2rem;max-width: 1444px;margin-left: auto;margin-right: auto;"
>
  <section class="main-checkout" id="checkout-section-1">
    <section class="flex-col gap-20">
      <div class="h-max checkout-div">
        <div class="custom-padding">
          <div class="cart-header-flex mt-10 mb-10">
            <div class="responsive-flex">
              <img
                src="{{ 'cannacabana-store-default.webp' | asset_url }}"
                id="mainStoreLogo"
                alt="pickup logo"
                class="current-store-img product-img"
                style="border:none;height:40px;"
              >
              <h3 class="weight-600" style="font-size:1.1rem;">Canna Cabana - <span class="store-title"></span></h3>
            </div>
            <a href="/" class="span-button">Continue Shopping</a>
          </div>
          <div class="responsive-flex align-start">
            <div class="flex-col width-50">
              <h3 class="f-16 grey pt-10">Location</h3>
              <p class="margin-0">
                <span id="main-address-line-1"></span>
                <br>
                <span id="main-address-line-2"></span>
              </p>
            </div>
            <div class="flex-col width-50">
              <h3 class="f-16 grey pt-10">Today's hours</h3>
              <p class="margin-0">Pickup <span class="mainPickupTime"></span></p>
            </div>
          </div>
        </div>

        <hr class="custom-hr">

        <div id="cart-item-list"></div>

        <br>
      </div>
      <div class="modal-container" style="--m-background: transparent">
        <div class="custom-modal">
          <div class="modal-header flex">
            <span class="pointer" onclick="handleModalClose()">
              <i class="fa-solid fa-xmark fa-2x"></i>
            </span>
            <h2 class="margin-0">Edit order</h2>
          </div>
          <hr class="custom-hr">
          <div class="flex-product modal-padding">
            <div class="flex-start">
              <img
                id="modal-img"
                class="product-img"
                src=""
                alt="product-assets"
              >
            </div>
            <div class="flex-col w-100">
              <div class="product-block-1 mb-10">Indica</div>
              <div id="modal-product-title" class="weight-600 text-start"></div>
              <div class="flex-col">
                <p id="modal-vendor" class="margin-0"></p>
                <p id="modal-quantity-with-price" class="margin-0"></p>
                <p id="modal-sale-with-title" class="margin-0 custom-line-height"></p>
              </div>
            </div>
          </div>

          <div class="modal-items-center">
            <div class="flex-col w-30 align-center">
              <div class="weight-600 mb-10">Select quantity</div>
              <div class="flex mt-10 gap-20">
                <span class="pointer" id="decrementBtn" onclick="decrementQuantity()">
                  <i class="fa-solid fa-minus fa-2x"></i>
                </span>
                <div id="modal-order-quantity" class="order-quantity"></div>
                <span class="pointer" id="incrementBtn" onclick="incrementQuantity()">
                  <i class="fa-solid fa-plus fa-2x"></i>
                </span>
              </div>
            </div>
            <div class="flex-col w-30 align-center">
              <h2 id="modal-price" class="margin-0">$5.99</h2>
              <button class="mt-10 custom-button" onclick="handleItemUpdate()">Update</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div>
      <div class="h-max checkout-div-v2">
        <div direction="horizontal" class="delivery-options-tabs">
          <button
            class="delivery-option delivery-option-selected"
            id="order-pickup"
            oncLick="handleTabChange('pickup')"
          >
            <p
              class="f-16 weight-600  text-center "
            >
              Pickup
              <span class="free"> Free </span>
            </p>
          </button>
          <button
            id="order-delivery"
            class="delivery-option delivery-option-unselected hidden"
            oncLick="handleTabChange('delivery')"
          >
            <p
              class="f-16 weight-600  text-center "
            >
              Delivery
              <span class="free"> $ </span>
            </p>
          </button>
        </div>

        <div class="checkout-div-content">
          <div class="delivery-options hidden">
            <p class="f-16 weight-600 ">Delivery Address</p>
            <div class="inputs-grid-item pt-10">
              <label class="input-label" for="delivery-address">Delivery Address</label>
              <input type="text" name="delivery-address" id="checkout-delivery-address">
              <div class="red-color pt-10 hidden f-14" id="checkout-delivery-address-error">
                Please enter your address
              </div>
            </div>
            <div class="inputs-grid-item pt-10">
              <label class="input-label" for="unit-number">Address line 2</label>
              <input type="text" name="unit-number" id="checkout-delivery-floor">
              <div class="red-color pt-10 hidden f-14" id="checkout-delivery-floor-error"></div>
            </div>

            <div class="inputs-grid-item pt-10">
              <label class="input-label" for="delivery-city">City</label>
              <input type="text" name="delivery-city" id="checkout-delivery-city">
              <div class="red-color pt-10 hidden f-14" id="checkout-delivery-city-error"></div>
            </div>

            <div class="inputs-grid-item pt-10">
              <label class="input-label" for="delivery-state">State</label>
              <input type="text" name="delivery-state" id="checkout-delivery-state">
              <div class="red-color pt-10 hidden f-14" id="checkout-delivery-state-error"></div>
            </div>

            <div class="inputs-grid-item pt-10">
              <label class="input-label" for="delivery-postal-code">Postal Code</label>
              <input type="text" name="delivery-postal-code" id="checkout-delivery-postal-code">
              <div class="red-color pt-10 hidden f-14" id="checkout-delivery-postal-code-error"></div>
            </div>
          </div>
          <div class="pt-10 summary-grid pricing-summary"></div>
          <hr class="custom-hr">
          <div
            class="flex-between mb-10 pointer promo-div"
            onclick="handlePromoClick()"
          >
            <div class="flex">
              <span class="custom-promo-icon">
                <i class="fa-solid fa-percent"></i>
              </span>
              <p class="f-16 weight-600">Apply promo code</p>
