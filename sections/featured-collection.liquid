        },
        {
          "value": "center",
          "label": "t:sections.featured-collection.settings.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.featured-collection.settings.text_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.featured-collection.settings.text_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "default": "2",
      "label": "t:sections.featured-collection.settings.products_per_row_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.featured-collection.settings.products_per_row_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.featured-collection.settings.products_per_row_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": true,
      "label": "t:sections.featured-collection.settings.swipe_on_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "enable_elite_styling",
      "label": "Enable Elite Button",
      "default": false
    },
    {
      "type": "url",
      "id": "elite_button_link",
      "label": "t:sections.slideshow.blocks.slide.settings.elite_button_link.label"
    },
    {
      "type": "inline_richtext",
      "id": "elite_subtitle",
      "label": "Elite Subtitle"
    },
    {
      "type": "inline_richtext",
      "id": "ab_subtitle",
      "label": "Alberta Subtitle"
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "limit": 5,
      "name": "t:sections.collection-list.blocks.featured_collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.collection.label"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-1"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.all.heading.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.presets.name",
      "blocks": [
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
