{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.50 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.50 | round: 0 }}px;
  }

 @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

 .section-{{ section.id }}-padding {
    margin-top: 16px;
    margin-bottom: 16px;
  }

  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      margin-top: 32px;
      margin-bottom: 32px;
    }
  }

  @media screen and (min-width: 1201px) {
    .section-{{ section.id }}-padding {
     margin-top: 64px;
     margin-bottom: 64px;
    }
  }
{%- endstyle -%}

{% assign content = section.blocks | where: 'type', 'item' %}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="isolate content-container content-container--full-width">
      <div>
        {% if content.size > 0 %}
          <ol class="decorative-list-content-wrapper__inner">
            {% for block in content %}
              <li class="decorative-list-section__content sp-small">
                {%- if block.settings.subheading != blank -%}
                  <div class="subheading__text rte">
                    <p>{{ block.settings.subheading }}</p>
                  </div>
                {%- endif -%}
                 {% if block.settings.heading != blank %}
                  <h3
                    class="h2 inline-richtext {{ block.settings.heading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h3>
                {%- endif -%}
                {% if block.settings.description != blank %}
                  <div class="decorative-list-block__description rte" {{ block.shopify_attributes }}>
                    {{ block.settings.description }}
                  </div>
                {% endif %}
              </li>
            {% endfor %}
          </ol>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.decorative_list.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.popups"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.section_spacing.content",
      "info": "t:sections.all.section_spacing.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.section_spacing.above",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.section_spacing.below",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.decorative_list.blocks.item.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Heading",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:sections.all.description.label",
          "default": "<p>Include frequently asked questions (FAQs) in this section to provide comprehensive information and address common queries.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.decorative_list.name",
      "blocks": [
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
