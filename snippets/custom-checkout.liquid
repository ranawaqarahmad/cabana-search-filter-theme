{% assign cart_subtotal = 0 %}
{% assign total_saving = 0 %}
{% assign sales_tax = 0 %}
{% assign total_price = 0 %}

{% comment %} Use string splitting to pull the value from content_for_header and apply some string clean up {% endcomment %}
{% comment %}{%- assign pageUrl = contentForQuerystring
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: '.myshopify.com'
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}

{%- assign pageQuerystring = pageUrl | split: '?' | last -%}
{% endcomment %}

{% assign sID = store_id %}

<div class="d-none">
  {% for item in cart.items %}
    {% assign metaString = item.variant.metafields.jane[sID] | split: ',' %}
    {% assign item_member_price = metaString[1] | times: item.quantity %}
    {% assign difference = metaString[2] | minus: metaString[1] | times: item.quantity %}

    {% assign cart_subtotal = cart_subtotal | plus: item_member_price %}
    {% assign total_saving = total_saving | plus: difference %}

    <span
      class="variant-meta-strings"
      id="line-item-{{ item.id }}"
      data-item-id="{{ item.id }}"
      data-product-id="{{ item.product.id }}"
      data-variant-id="{{ item.variant.id }}"
      data-meta-string="{{ item.variant.metafields.jane[sID] }}"
    >
    </span>
  {% endfor %}

  {% assign total_price = sales_tax | plus: cart_subtotal %}
</div>

