      'Content-Type': 'application/json',
      Authorization : `Bearer ${token}`,
    },
    body   : JSON.stringify(orderDetails),
  });
  const data  = await resp.json();

  if (data.success) {
    orderSuccessHandler(true);
  } else {
    console.log(data);
    alert('SOME ERROR IN {orderCompletedByOnlinePayment}');
  }
  hideLoader();
}

async function orderCompletedByOnlinePayment(e) {
  const event = JSON.parse(e);
  console.log('EVENT#############', event);
  const {handler, ticket, response_code} = event;

  if (response_code != '001') {
    return console.error('TRANSACTION FAILED');
  }

  showLoader();

  let location_dynamics = [];

  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition((position) => {
      location_dynamics.push(position.coords.longitude);
      location_dynamics.push(position.coords.latitude);
    });
  }

  try {
    const payload = getOrderPayload();
    const token   = await getAccessToken();
    const resp    = await fetch(`${baseServerURL}/checkout/get-receipt`, {
      method : 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization : `Bearer ${token}`,
      },
      body   : JSON.stringify({
        ...payload,
        moneris_checkout_ticket: ticket,
        moneris_event          : handler,
        ticket_id              : event.ticket,
        store_id,
        longitude              : localStorage.getItem('latitude_a'),
        latitude               : localStorage.getItem('longitude_a')
      }),
    });

    const data = await resp.json();
    console.log('API RESPONSE==>>>', data);

    if (data.success == true) {
      orderSuccessHandler();
    } else {
      orderCancelHandler();
    }

  } catch (e) {
    console.log('SOME ERROR IN get-receipt', e);
    orderCancelHandler();
  } finally {
    hideLoader();
    document.querySelector('header').classList.remove('d-none');
  }
}

async function orderSuccessHandler(is_cod = false) {
  if (is_cod) {
    checkoutSection2.classList.add('d-none');
    checkoutSection3.classList.add('d-none');
    checkoutSection4.classList.remove('d-none');
  } else {
    checkoutSection3.classList.add('d-none');
    checkoutSection4.classList.remove('d-none');
  }

 // await emptyCart();
  window.location.href = '/pages/thank-you';
}

function orderCancelHandler() {
  myCheckout.closeCheckout(' ');
  checkoutSection3.classList.add('d-none');
  checkoutSection5.classList.remove('d-none');
}

async function cancelOrder(e) {
  console.log('###################### - myCancelTransaction', e);
  document.querySelector('header').style.display = 'block';
  window.location.reload();
}

function getOrderPayload() {
  const {total_price, actual_price, discount, sales_tax_percentage, sales_tax} = getTotalPrices();

  var tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);

  let delivery_date = '';

  if (deliveryTime.value) {
    delivery_date = deliveryTime.value;
  }

  return {
    pickup_day          : pickupDay.value === 'today' ? formateDate(new Date()) : formateDate(tomorrow),
    instructions        : specialInstructions.value,
    first_name          : section2FirstName.value,
    last_name           : section2LastName.value,
    dob                 : section2BirthDate.value,
    email               : section2Email.value,
    phone               : section2MobileNum.value,
    is_payment_online   : is_payment_online,
    items               : items,
    customer_id         : __st.cid,
    price               : total_price,
    store_id,
    disount_amount      : discount,
    coupon_id           : coupon ? coupon.id : null,
    actual_price        : actual_price,
    sales_tax_percentage: sales_tax_percentage,
    sales_tax_price     : sales_tax,
    is_delivery_enabled : pickupValue === 'delivery',
    external_identifier : 'cc_',
    delivery_address    : {
      line_1  : checkoutDeliveryAddress.value,
      line_2  : checkoutDeliveryFloor.value,
      city    : checkoutDeliveryCity.value,
      state   : checkoutDeliveryState.value,
      zip_code: checkoutDeliverypostalCode.value,
      country : 'Canada',
      delivery_date,
    },
    line_items          : items.map((item) => {
      const i = metaDataArray.find((meta) => meta.item_id == item.id);

      return {
        sku       : item.sku,
        quantity  : item.quantity,
        price     : i.price,
        meta      : i.metaStr,
        gt_item_id: item.gt_item_id,
      };
    }),
  };
}

async function emptyCart() {
  const resp = await fetch(window.Shopify.routes.root + 'cart/clear.js', {
    method : 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body   : JSON.stringify({}),
  });

  await resp.json();

  const span = document.querySelector('.site-header-cart--count.visible');
  if (span) {
    span.setAttribute('data-header-cart-count', 0);
  }
  return;
}

function initializeMonerisCheckout() {
  myCheckout.setCheckoutDiv('monerisCheckout');
  myCheckout.setCallback('page_loaded', myPageLoad);
  myCheckout.setCallback('page_closed', myPageClosed);
  myCheckout.setCallback('payment_submitted', myPaymentSubmitted);

  myCheckout.setCallback('cancel_transaction', cancelOrder);
  myCheckout.setCallback('error_event', cancelOrder);

  myCheckout.setCallback('payment_receipt', orderCompletedByOnlinePayment);
  myCheckout.setCallback('payment_complete', orderCompletedByOnlinePayment);
}

const handlePromoClick = () => {
  iconTransform.classList.toggle('fa-rotate-180');
  promoCodeDiv.classList.toggle('hidden');
};

initializeMonerisCheckout();
initializeValues();

// TODO confirm if this is needed for anything?? Assuming it's tied into the scripts at the top
