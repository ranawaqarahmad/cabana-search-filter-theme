{% unless template == 'cart' %}
  {% include 'store-id' %}

  <div class="js-atc-toast toast__atc">
    {% render 'toast', title: 'Success!', description: 'Item added to cart.', button-content: 'View Cart', link: '/cart', toast-type: 'success', store_id: store_id %}
  </div>

  <div class="js-atc-error-toast toast__atc">
    {% render 'toast', title: 'Uh oh!', description: 'There was an error adding your item to the cart.', toast-type: 'error', store_id: store_id %}
  </div>

  <div class="js-atc-quantity-error-toast toast__atc">
    {% render 'toast', title: 'Stock Limit Exceeded', description: 'Please reduce the quantity to proceed.', toast-type: 'error', store_id: store_id %}
  </div>
{% endunless %}

{% schema %}
{
  "name": "Cart Toast",
  "class": "section cart-drawer",
  "settings": [
  ]
}
{% endschema %}
