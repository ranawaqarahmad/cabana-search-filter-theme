function convertToAMPM(time24) {
  const hours = time24.slice(0, 2);
  const minutes = time24.slice(2);
  const date = new Date();
  date.setHours(hours);
  date.setMinutes(minutes);
  const time12 = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
  return time12;
}

