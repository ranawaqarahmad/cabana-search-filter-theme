    let { from, to } = getRange(date, true);
    totalRange.push({
      title: `Tomorrow ${date}pm - ${date + 2}pm`,
      value: `${from} - ${to}`,
      is_in_range: today < from,
    });
  });

  const validRanges = totalRange.filter((r) => r.is_in_range);

  validRanges.forEach((range, idx) => {
    const option = document.createElement('option');
    option.value = range.value;
    option.innerHTML = range.title;
    select.appendChild(option);
  });
}
{% endcomment %}
function getRange(hour = 1, isTomorrow = false) {
  const from = new Date();
  const to   = new Date();

  if (isTomorrow) {
    from.setDate(from.getDate() + 1);
    to.setDate(to.getDate() + 1);
  }

  from.setHours(hour);
  from.setMinutes(0);
  from.setSeconds(0);

  to.setHours(hour + 2);
  to.setMinutes(0);
  to.setSeconds(0);

  return {
    from,
    to,
  };
}

async function applyCouponCode() {
  const couponEl = document.querySelector('#coupon-code');
  if (!couponEl.value) {
    return alert('Please Enter Coupon Code');
  }

  try {
    showLoader();
    const token = await getAccessToken();
    const resp  = await fetch(`${baseServerURL}/coupon/validate`, {
      method : 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization : `Bearer ${token}`,
      },
      body   : JSON.stringify({
        coupon: couponEl.value,
      }),
    });

    const data = await resp.json();
    if (data.message === 'verified') {
      coupon = data.data;
      renderPricingSummary();
    } else {
      alert(data.message);
    }
  } catch (e) {
    console.log('############################', e);
  } finally {
    hideLoader();
  }
}

