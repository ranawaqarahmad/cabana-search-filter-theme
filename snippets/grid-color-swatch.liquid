<grid-color-swatches class="product-color__grid{% if grid_text_alignment %} justify-{{ grid_text_alignment }}{% endif %}">
  {% for option in card_product.options %}
    {% liquid 
        assign colorOption =  option | downcase
    %}
    {% if colorOption == 'color' or colorOption == 'colour' %}
        {% liquid 
            assign index = forloop.index0
            assign colorlist = ''
            assign color = ''
            assign counter = 0
        %}
        {% for variant in card_product.variants %}
            {% capture color %}
                {{ variant.options[index] }}
            {% endcapture %}
            {% unless colorlist contains color %}
                {% liquid 
                    assign counter = counter | plus: 1 
                %}
                {% if counter > 4 %}
                <div class="color-swatch__list color-more">
                    <a href="{{ card_product.url }}" aria-label="view-card_product">
                    {% render 'theme-icons', icon: 'plus' %}
                    </a>
                </div>
                {% break %}
                {% endif %}
                {% liquid
                  assign colorHexCode = ''
                  assign colorValueDowncase = color | handleize
                  assign swatchConfig = settings.custom_color_swatch | newline_to_br | split: '<br />'
                  for colorItem in swatchConfig
                    assign splitItem = colorItem | split: ':'
                    assign colorName = splitItem.first | handleize
                    if colorValueDowncase == colorName
                      assign colorValue = splitItem.last | strip 
                      if colorValue contains '#'
                        assign colorHexCode = colorValue
                      endif
                      break
                    endif
                  endfor
                  assign color_file_name = color | handle | append: '.png'
                  assign color_image = color_file_name | file_img_url: '40x40' | prepend: 'https:' | split: '?' | first
                -%}
                <div class="swatch-list">
                <input type="radio" class="color-swatch__radio" data-image-element="image-{{ section.id }}__{{ card_product.id }}" data-product-handle={{ card_product.handle }} data-variant-id="{{ variant.id }}" name="color-swatch__{{ section.id }}-{{ card_product.id }}" id="color-swatch__{{ color | handleize }}-{{ section.id }}-{{ card_product.id }}">
                <label for="color-swatch__{{ color | handleize }}-{{ section.id }}-{{ card_product.id }}" title="{{ color }}" class="color-swatch__item" style="background-color: {% if colorHexCode != '' %}{{ colorHexCode }}{% else %}{{ color | handleize }}{% endif %};{% if images[color_file_name] != blank %}  background-image: url({{ color_image }});{% endif %}"><span class="hidden">{{ color | downcase }}</span></label>
                </div>
                {% capture tempList %}{{ colorlist | append: color | append: ' ' }}{% endcapture %}
                {% assign colorlist = tempList %}
            {% endunless %}
        {% endfor %}
    {% endif %}
  {% endfor %}
</grid-color-swatches>