{% include 'store-id' %}
{% assign paginate_by = 100 %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 16px;
    padding-bottom: 16px;
  }

  @media screen and (min-width: 1201px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-padding {
    margin-top: 32px;
    margin-bottom: 32px;
  }

  @media screen and (min-width: 1201px) {
    .section-{{ section.id }}-padding {
      margin-top: 64px;
      margin-bottom: 64px;
    }
  }

  .section-{{ section.id }}-padding {
    margin-top: 32px;
    margin-bottom: 32px;
  }

  @media screen and (min-width: 1201px) {
    .section-{{ section.id }}-padding {
      margin-top: 64px;
      margin-bottom: 64px;
    }
  }

  {% if page.handle == 'elite' %}
    .Slider-{{ section.id }}{
       margin:0;
    }
  {% endif %}
  
{%- endstyle -%}

{%- liquid
  assign tabs = false
  for block in section.blocks
    if block.settings.collection != blank
      assign firstCollection = block.settings.collection
      assign tabs = true
      break
    endif
  endfor

  capture filtered_products
    paginate collections[firstCollection.handle].products by paginate_by
      for product in collections[firstCollection.handle].products
        assign product_has_jane_metafield = false

        if product.metafields.jane[store_id]
          assign product_metadata = product.metafields.jane[store_id] | split: ','
          if product_metadata[1] != '0' and product_metadata[1] != 'N.A'
            assign product_has_jane_metafield = true
          endif
        else
          for variant in product.variants
            if variant.metafields.jane[store_id]
              assign variant_metadata = variant.metafields.jane[store_id] | split: ','
              if variant_metadata[1] != '0' and variant_metadata[1] != 'N.A'
                assign product_has_jane_metafield = true
                break
              endif
            endif
          endfor
        endif

        if product_has_jane_metafield
          echo product.id | prepend: ','
        endif
      endfor
    endpaginate
  endcapture

  assign filtered_products = filtered_products | remove_first: ',' | split: ','
  assign products_to_display = filtered_products.size

  if products_to_display > section.settings.products_to_show
    assign more_in_collection = true
  endif

  assign products_per_row_mobile_int = section.settings.products_per_row_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and products_to_display > products_per_row_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if section.settings.enable_slider_scrollbar and products_to_display > section.settings.products_per_row
    assign show_desktop_slider = true
  endif
-%}

<script>
document.addEventListener('DOMContentLoaded', function () {
  const province = localStorage.getItem('global_province');
  const albertaText = document.querySelectorAll('.js-alberta-description');

  if (province !== 'Alberta') {
    albertaText.forEach(function(element) {
      element.style.display = 'none';
    });
  }
});
</script>

{% if products_to_display > 0 %}
  <div class="js-hide-by-province hidden color-{{ section.settings.color_scheme }} isolate gradient" data-hide-province="{% if section.settings.hide_for_bc %}British Columbia,{% endif %}{% if section.settings.hide_for_ab %}Alberta,{% endif %}">
    <div class="collection Slider-{{ section.id }} section-{{ section.id }}-padding">
      <div class="page-width">
        {%- unless section.settings.title == blank -%}
          <div class="section-heading__bar text-{{ section.settings.heading_alignment }}{% if tabs and section.blocks.size > 1 %} with-collection-tabs{% endif %}">
            <h2 class="title {{ section.settings.heading_size }}">
              {{ section.settings.title }}
            </h2>
            {% if tabs and section.blocks.size > 1 %}
              <collection-tabs class="featured-collection__tabs" data-section-id="{{ section.id }}">
                {% for block in section.blocks %}
                  {% if block.settings.collection != blank %}
                    <button class="collection-tab-button h6{% if forloop.index == 1 %} active{% if template.name == 'collection' %} featured-collection-first{% endif %}{% endif %}" data-id="collection-item-{{ section.id }}" data-collection-handle="{{ block.settings.collection.url }}">{% if block.settings.title != blank %}{{ block.settings.title }}{% else %}{{ block.settings.collection.title }}{% endif %}</button>
                  {% endif %}
                {% endfor %}
              </collection-tabs>
            {% endif %}
          </div>
        {%- endunless -%}
        {% if section.settings.elite_subtitle and section.settings.enable_elite_styling %}
          <div class="js-hide-by-province hidden section-subtitle" data-hide-province="Alberta">
            <p class="title">
              {{ section.settings.elite_subtitle }}
            </p>
          </div>
        {% endif %}
        {% if section.settings.ab_subtitle %}
          <div class="section-subtitle js-alberta-description">
            <p class="title">
              {{ section.settings.ab_subtitle }}
            </p>
          </div>
        {% endif %}
        <div class="component-view-all__btn" id="collection-data-{{ section.id }}" data-scrolling="true">
          <slider-component class="slider-mobile-gutter slider--card-collection {% if show_desktop_slider %} slider-component-desktop{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            <ul
              id="Slider-{{ section.id }}"
              class="grid product-grid contains-card scroll--padding contains-card--product grid--{{ section.settings.products_per_row }}-col-desktop grid--3-col-tablet grid--{{ section.settings.products_per_row_mobile }}-col-tablet-down {% if show_desktop_slider %}slider slider--everywhere slider-dot-arrow-true{% elsif show_mobile_slider %} slider slider--tablet slider-scrollbar-mobile{% endif %}{% if section.settings.show_view_all and more_in_collection %} enabled-view__all{% endif %}"
              role="list"
              aria-label="{{ 'general.slider.name' | t }}"
            >
              {% paginate collections[firstCollection.handle].products by paginate_by %}
                {% assign slide_count = 0 %}
                {% for product in collections[firstCollection.handle].products %}
                  {% liquid
                    assign show_product = false

                    if product.metafields.jane[store_id] != blank
                      assign product_metadata = product.metafields.jane[store_id] | split: ','
                      if product_metadata[1] != '0' and product_metadata[1] != 'N.A.'
                        assign show_product = true
                      endif
                    else
                      for variant in product.variants
                        if variant.metafields.jane[store_id] != blank
                          assign variant_metadata = variant.metafields.jane[store_id] | split: ','
                          if variant_metadata[1] != '0' and variant_metadata[1] != 'N.A.'
                            assign show_product = true
                            break
                          endif
                        endif
                      endfor
                    endif %}
                  {% if show_product %}
                    {% assign slide_count = slide_count | plus: 1 %} <!-- Increment slide count -->
                    <li
                      id="Slide-{{ section.id }}-{{ forloop.index }}"
                      class="grid__item{% if show_mobile_slider or show_desktop_slider %} slider__slide{% endif %}"
                    >
                      {% render 'card-product',
                        card_product: product,
                        media_aspect_ratio: section.settings.image_ratio,
                        image_shape: 'default',
                        horizontal_quick_add: false,
                        grid_text_alignment: section.settings.grid_text_alignment,
                        grid_color_scheme: section.settings.grid_color_scheme,
                        grid_style: section.settings.grid_style,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_rating: false,
                        show_quick_add: false,
                        show_color_swatches: false,
                        section_id: section.id,
                        store_id: store_id
                      %}
                    </li>
                    {% if slide_count == products_to_display or slide_count >= section.settings.products_to_show %}
                      {% break %}
                    {% endif %}
                  {% endif %}
                {%- endfor -%}
              {% endpaginate %}
            </ul>

            {% assign products_to_show = section.settings.products_to_show | plus: 0 %}
            {% assign products_per_row = section.settings.products_per_row | plus: 0 %}
            {% assign slide_count = slide_count | plus: 0 %}
            {% assign difference = section.settings.products_to_show | plus: 1 | minus: section.settings.products_per_row %}
            {% assign adjusted_slide_count_desktop = slide_count | minus: difference %}
            {% assign adjusted_slide_count_tablet = adjusted_slide_count_desktop | plus: 1 %}

            <style>
              {% for i in (0..slide_count) %}
                .slider-counter__link.slider-counter__link-{{ section.id }}-{{ i }} {
                  display: block !important;
                }
              {% endfor %}

              @media screen and (min-width: 769px) {
              {% for i in (0..slide_count) %}
                .slider-counter__link.slider-counter__link-{{ section.id }}-{{ i }} {
                  display: none !important;
                }
              {% endfor %}

              {% for i in (0..adjusted_slide_count_tablet) %}
                .slider-counter__link.slider-counter__link-{{ section.id }}-{{ i }} {
                  display: block !important;
                }
              {% endfor %}
              }

              @media screen and (min-width: 1201px) {
                {% for i in (0..slide_count) %}
                  .slider-counter__link.slider-counter__link-{{ section.id }}-{{ i }} {
                    display: none !important;
                  }
                {% endfor %}

                {% for i in (0..adjusted_slide_count_desktop) %}
                  .slider-counter__link.slider-counter__link-{{ section.id }}-{{ i }} {
                    display: block !important;
                  }
                {% endfor %}
              }
            </style>

            {% if show_desktop_slider or show_mobile_slider %}
              {% if slide_count > section.settings.products_per_row %}
                <div class="featured-collection-slider-controls slideshow__controls slider-buttons no-js-hidden">
                  <div class="slider__controls-area-tablet no-js-hidden">
                    <div class="slider-counter">
                      <div class="slideshow__control-wrapper slider__controls-arrow">
                        <button type="button" class="slider-button slider-button--prev arrow-with-dots" name="previous" aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}">
                          {% render 'theme-icons', icon: 'slider-icon-left' %}
                        </button>

                        {% for i in (1..slide_count) %}
                          <button class="slider-counter__link slider-counter__link--dots slider-counter__link-{{ section.id }}-{{ i }}" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ i }} {{ 'general.slider.of' | t }} {{ slide_count }}" aria-controls="Slider-{{ section.id }}">
                            <span class="slider-counter-dots">
                              <span class="dot"></span>
                            </span>
                          </button>
                        {%- endfor -%}

                        <button type="button" class="slider-button slider-button--next arrow-with-dots" name="next" aria-label="{{ 'sections.slideshow.next_slideshow' | t }}">
                          {% render 'theme-icons', icon: 'slider-icon-right' %}
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endif %}
          </slider-component>
          {%- if section.settings.show_view_all and more_in_collection -%}
            <div
              class="center featured_collection__view-all{% if show_desktop_slider %} view-btn-scrollbar-everywhere{% elsif show_mobile_slider %} view-btn--scrollbar-mobile{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
              {% endif %}
            >
              <a
                href="{{ firstCollection.url }}"
                class="button btn-view__all"
                id="ViewAllButton-{{ section.id }}"
                aria-label="collection-view-all"
                aria-labelledby="{{ 'sections.featured_collection.view_all_label' | t: collection_name: firstCollection.title }}"
              >
                {% render 'theme-icons', icon: 'top-arrow' %}
                <span>{{ 'sections.featured_collection.view_all' | t }}</span>
              </a>
            </div>
          {%- endif -%}
        </div>
        {% if section.settings.enable_elite_styling %}
          <div class="featured_collection__elite-view-all">
            {% if page.template_suffix != 'elite-landing-page' and page.template_suffix != 'cabana-club' %}
            <a
              href="{{ section.settings.elite_button_link }}"
              aria-label="collection-view-all"
              aria-labelledby="{{ 'sections.featured_collection.view_all_label' | t: collection_name: firstCollection.title }}"
              class="button button--elite button--icon"
            >
              {{ 'sections.featured_collection.elite' | t }}
              {%- render 'theme-icons', icon: 'icon-chevron-right' -%}
            </a>
          {% elsif customer %}
            <a href="/products/cabana-elite-annual" class="button button--elite button--icon">Upgrade To Elite
              {% render 'theme-icons', icon: 'icon-chevron-right' %}
            </a>
          {% else %}
            <a href="{{ routes.account_register_url }}" class="button button--primary button--icon">Join Now
              {% render 'theme-icons', icon: 'icon-chevron-right' %}
            </a>
          {% endif %}

          </div>
        {% endif %}
        {% if section.settings.enable_shop_all and section.settings.shop_all_link %}
          <div class="featured_collection__shop_all">
            <a
              href="{{ section.settings.shop_all_link }}"
              aria-label="collection-view-all"
              aria-labelledby="{{ 'sections.featured_collection.view_all_label' | t: collection_name: firstCollection.title }}"
              class="button button--primary"
            >
              {{ section.settings.shop_all_text }}
            </a>
          </div>
          {% if section.settings.enable_elite_styling %}
            <div class="featured_collection__elite-view-all hidden">
              <a
                href="{{ section.settings.elite_button_link }}"
                aria-label="collection-view-all"
                aria-labelledby="{{ 'sections.featured_collection.view_all_label' | t: collection_name: firstCollection.title }}"
                class="button button--primary button--icon"
              >
                {{ 'sections.featured_collection.is_elite' | t }}
                {%- render 'theme-icons', icon: 'icon-chevron-right' -%}
              </a>
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}
<script>
  {% if firstCollection == 'elite' or firstCollection == 'elite-products' or firstCollection == 'elite-accessories'  %}
      document.querySelectorAll('.no_elite').forEach(function(p) {
          p.parentElement.remove();
      });
{% endif %}
</script>
{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.popups"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.all.heading.label",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "checkbox",
      "id": "enable_shop_all",
      "label": "Enable Shop All Button",
      "default": false
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop All Link Destination"
    },
    {
      "type": "inline_richtext",
      "id": "shop_all_text",
      "label": "Shop All Button Text"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.heading_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.heading_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.heading_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.all.heading_alignment.label"
    },
    {
      "type": "checkbox",
      "id": "hide_for_bc",
      "label": "t:settings_schema.general.settings.hide_for_bc"
    },
    {
      "type": "checkbox",
      "id": "hide_for_ab",
      "label": "t:settings_schema.general.settings.hide_for_ab"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 100,
      "step": 1,
      "default": 8,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.products_per_row.label"
    },
    {
      "type": "checkbox",
      "id": "enable_slider_scrollbar",
      "label": "t:sections.featured-collection.settings.slider_scrollbar.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_view_all.label",
      "info": "t:sections.featured-collection.settings.show_view_all.info"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header.content"
    },
    {
      "type": "color_scheme",
