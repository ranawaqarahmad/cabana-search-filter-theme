{{ 'section-locations-nearby.css' | asset_url | stylesheet_tag }}

{% render 'locations-js' %}

{% comment %}@formatter:off{% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.50 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.50 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-padding {
    margin-top: 16px;
    margin-bottom: 16px;
  }

  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      margin-top: 32px;
      margin-bottom: 32px;
    }
  }

  @media screen and (min-width: 1201px) {
    .section-{{ section.id }}-padding {
      margin-top: 64px;
      margin-bottom: 64px;
    }
  }
{%- endstyle -%}
{% comment %}@formatter:on{% endcomment %}

<div class="js-locations-nearby color-{{ section.settings.color_scheme }} gradient{% if section.settings.title == blank %} no-heading{% endif %}">
  <div
    class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- unless section.settings.title == blank -%}
      <div class="section-heading__bar sp-small mgb-medium text-{{ section.settings.heading_alignment }}">
        <h2 class="title {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}
    <slider-component class="slider-mobile-gutter">
      <ul
        class="js-closest-stores contains-content-container grid grid--1-col-tablet-down grid--2-col-tablet grid--{{ section.settings.columns_per_row }}-col-desktop"
        id="Slider-{{ section.id }}"
        role="list"
      >
        <li>{%- render 'theme-icons', icon: 'loader', class: 'loading__spinner' -%}</li>
      </ul>
    </slider-component>

    <div
      class="center locations-view-all{% if section.settings.enable_slider_scrollbar and section.blocks.size > collections_per_row %} view-btn-scrollbar-everywhere{% elsif show_mobile_slider %} view-btn--scrollbar-mobile{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
      {% endif %}
    >
      <a href="/pages/store-locator" class="button button--primary">{{ 'locations.find_more' | t }}</a>
    </div>
  </div>
</div>

<script>
function findClosestStores(currentLat, currentLon, stores, numClosest = 3) {
  const distances = [];

  for (const key in stores) {
    if (stores.hasOwnProperty(key)) {
      const store    = stores[key];
      const storeLat = store.address.latitude;
      const storeLon = store.address.longitude;

      const distance = getDistanceFromLatLonInKm(currentLat, currentLon, storeLat, storeLon);
      distances.push({distance, store});
    }
  }

  distances.sort((a, b) => a.distance - b.distance);
  return distances.slice(0, numClosest);
}

function getCurrentLocation() {
  const container = document.querySelector('.js-locations-nearby');

  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition((position) => {
      const currentLat = position.coords.latitude;
      const currentLon = position.coords.longitude;
      displayClosestStores(currentLat, currentLon);
    }, (error) => {
      container.style.display = 'none';
    });
  } else {
    container.style.display = 'none';
  }
}

function displayClosestStores(currentLat, currentLon) {
  const closestStores = findClosestStores(currentLat, currentLon, window.stores);

  const closestStoresDiv     = document.querySelector('.js-closest-stores');
  closestStoresDiv.innerHTML = '';
  closestStores.forEach(({distance, store}, index) => {
    const storeElement     = document.createElement('li');
    storeElement.className = `multicolumn-list__item location-nearby__card grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}`;
    storeElement.id        = `Slide-{{ section.id }}-${index}`;
    storeElement.setAttribute('data-cascade', '');
    storeElement.setAttribute('style', `--animation-order: ${index};`);

    if (store.img) {
      storeElement.innerHTML += `<img class="location-nearby__card-image" src="${store.img}" width="390" height="141" alt="">`;
    } else {
      storeElement.innerHTML += `<img class="location-nearby__card-image" src="{{ 'cannacabana-store-default.webp' | asset_url }}" width="390" height="141" alt="">`;
    }

    if (store.title) {
      storeElement.innerHTML += `<div class="location-nearby__card-title-wrapper">
                                  <h3 class="location-nearby__card-title">${store.title}</h3>
                                  <span>${distance ? `| ${distance.toFixed(2)} {{ 'locations.distance_away' | t }}` : ''}</span>
                              </div>`;
    }

    if (store.licence_id) {
      storeElement.innerHTML += `<p class="location-nearby__card-licence">{{ 'locations.licensee' | t }}: ${store.licence_id}</p>`;
    }

    if (store.address) {
      storeElement.innerHTML += `<p class="location-nearby__card-address">${store.address.street1}, ${store.address.city}, ${store.address.province}</p>`;
    }

    if (store.store_id && store.address && store.address.province) {
      storeElement.innerHTML += `<div class="location-nearby__card-buttons">
                                   <button class="button button--primary" onclick="shopThisStore(${store.store_id}, '${store.address.province}')">{{ 'locations.shop_here' | t }}</button>
                                   <a href="/pages/store/${store.handle}" class="button button--secondary">{{ 'locations.store_details' | t }}</a>
                                </div>`;
    } else if (store.handle) {
      storeElement.innerHTML += `<div class="location-nearby__card-buttons">
                                   <a href="/pages/store/${store.handle}" class="button button--secondary">{{ 'locations.store_details' | t }}</a>
                                </div>`;
    }

    closestStoresDiv.appendChild(storeElement);
  });
}

getCurrentLocation();
</script>

{% schema %}
{
  "name": "t:sections.locations_nearby.name",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.popups"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.heading_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.heading_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.heading_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.heading_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "columns_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.locations_nearby.settings.columns_per_row.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section_spacing.content",
      "info": "t:sections.all.section_spacing.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.section_spacing.above",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.section_spacing.below",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "t:sections.locations_nearby.presets.name"
    }
  ]
}
{% endschema %}
