{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'animated-text-columns.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'animated-counter.js' | asset_url | script_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.50 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.50 | round: 0 }}px;
  }

 @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }


 .section-{{ section.id }}-padding {
    margin-top: 16px;
    margin-bottom: 16px;
  }

  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      margin-top: 32px;
      margin-bottom: 32px;
    }
  }

  @media screen and (min-width: 1201px) {
    .section-{{ section.id }}-padding {
     margin-top: 64px;
     margin-bottom: 64px;
    }
  }

{%- endstyle -%}

{% if page.handle == 'elite' or page.handle == 'cabana-club' %}
  <style> 
      .text-columns-with-icons {
        margin: 0; 
      }
  </style>
{% endif %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="text-columns-with-icons page-width isolate section-{{ section.id }}-padding">
    {%- unless section.settings.title == blank -%}
      <div class="section-heading__bar sp-small mgb-medium text-{{ section.settings.heading_alignment }}">
        <h2 class="title {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
    </div>
    {%- endunless -%}
    <div class="text-columns-icon-items{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        class="text-with-icons-list grid grid--{{ section.settings.column_per_row }}-col-desktop grid--{{ section.settings.column_per_row_mobile }}-col-tablet-down text-columns-icon--{{ section.blocks.size }}-items"
        role="list"
      >
        {% for block in section.blocks %}
          <li class="text-with-icons-list__item animated-text-with-icons grid__item{% if settings.animations_reveal_on_scroll %} {{ block.settings.content_position }} text-alignment__{{ block.settings.text_alignment }}  scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
            <div class="text-with-icons-inner{% if section.settings.style == 'classic' %} text-with-icons--{{ section.settings.style }} color-{{ block.settings.color_scheme }}{% endif %}">
              {% if block.settings.image != blank %}
                <div class="icon-image justify-{{ section.settings.text_alignment }}">
                    <img
                      srcset="
                        {%- if block.settings.image.width >= 165 -%}{{ block.settings.image | image_url: width: 165 }} 165w,{%- endif -%}
                        {%- if block.settings.image.width >= 330 -%}{{ block.settings.image | image_url: width: 330 }} 330w,{%- endif -%}
                        {%- if block.settings.image.width >= 535 -%}{{ block.settings.image | image_url: width: 535 }} 535w,{%- endif -%}
                        {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                        {%- if block.settings.image.width >= 1000 -%}{{ block.settings.image | image_url: width: 1000 }} 1000w,{%- endif -%}
                        {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                        {%- if block.settings.image.width >= 3000 -%}{{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                        {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
                      "
                      src="{{ block.settings.image | image_url: width: 1500 }}"
                      sizes="
                        (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: section.settings.column_per_row }}px,
                        (min-width: 750px) {% if section.settings.column_per_row > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %},
                        calc(100vw - 3rem)
                      "
                      alt=""
                      height="{{ block.settings.image.height }}"
                      width="{{ block.settings.image.width }}"
                      loading="lazy"
                      class="motion-reduce main-image"
                    >
                </div>

                {% if block.settings.mobile_image != blank %}
                  {{ block.settings.mobile_image | image_url: width: 400 | image_tag: class: 'mobile-image' }}
                {% endif %}
              {% endif %}

              {% if block.settings.title != blank or block.settings.text != blank %}
                <div class="content-wrapper sp-small">
                  {% if block.settings.title != blank %}
                    <h3 class="h1">{{ block.settings.title }}</h3>
                  {% endif %}
                  {% if block.settings.metric != blank %}
                    <h3 class="h1 {% if block.settings.animated_counting %}enable-animated-counting{% endif %}"><span class="metric">{{ block.settings.metric }}</span>{% if block.settings.unit_suffix != blank %}<span class="unit-suffix">{{ block.settings.unit_suffix }}</span>{% endif %}</h3>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <div class="icon-content-description rte">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
              {%- if block.settings.button_label != blank -%}
                <div class="cta-button small-hide">
                  <a class="button button--secondary"
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </li>
        {% endfor %}
      </ul>

      {% for block in section.blocks %}
        {%- if block.settings.button_label != blank -%}
          <div class="cta-button medium-up-hide">
            <a class="button button--secondary"
              {% if block.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ block.settings.button_link }}"
              {% endif %}
            >
              {{- block.settings.button_label | escape -}}
            </a>
          </div>
        {%- endif -%}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.animated-text-columns.name",
  "max_blocks": 6,
  "disabled_on": {
    "groups": [
      "custom.popups"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Text columns with icons",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.heading_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.heading_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.heading_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.heading_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "column_per_row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.animated-text-columns.settings.columns_per_row.label"
    },
    {
      "type": "header",
      "content": "t:sections.animated-text-columns.settings.header_mobile.content"
    },
    {
      "type": "header",
      "content": "t:sections.all.section_spacing.content",
      "info": "t:sections.all.section_spacing.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.section_spacing.above",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.section_spacing.below",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.animated-text-columns.blocks.column.name",
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-1",
          "info": "t:sections.animated-text-columns.blocks.column.settings.color_scheme.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.animated-text-columns.blocks.column.settings.image.label"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:sections.animated-text-columns.blocks.column.settings.mobile_image.label"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.animated-text-columns.blocks.column.settings.title.label",
          "default": "Title"
        },
        {
          "type": "inline_richtext",
          "id": "metric",
          "label": "t:sections.animated-text-columns.blocks.column.settings.metric.label",
          "default": "1"
        },
        {
          "type": "inline_richtext",
          "id": "unit_suffix",
          "label": "t:sections.animated-text-columns.blocks.column.settings.unit_suffix.label",
          "default": "+"
        },
        {
          "type": "checkbox",
          "id": "animated_counting",
          "label": "t:sections.animated-text-columns.blocks.column.settings.animated_counting.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.all.description.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.masonry-grid.blocks.image.settings.button_label.label",
          "default": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.masonry-grid.blocks.image.settings.button_link.label"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "options": [
            {
              "value": "left",
              "label": "t:sections.all.heading_alignment.options__1.label"
            },
            {
              "value": "center",
              "label": "t:sections.all.heading_alignment.options__2.label"
            },
            {
              "value": "right",
              "label": "t:sections.all.heading_alignment.options__3.label"
            }
          ],
          "default": "center",
          "label": "t:sections.masonry-grid.blocks.image.settings.text_alignment.label"
        },
        {
          "type": "select",
          "id": "content_position",
          "options": [
            {
              "value": "content_left",
              "label": "t:sections.all.content_position.options__1.label"
            },
            {
              "value": "content_center",
              "label": "t:sections.all.content_position.options__2.label"
            },
            {
              "value": "content_right",
              "label": "t:sections.all.content_position.options__3.label"
            }
          ],
          "default": "content_center",
          "label": "t:sections.all.content_position.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.animated-text-columns.name",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
