{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

<style>
  .template-search__header {
    margin-bottom: 3rem;
  }

  .template-search__search {
    margin: 0 auto 3.5rem;
    max-width: 74.1rem;
  }

  .template-search__search .search {
    margin-top: 3rem;
  }

  .template-search--empty {
    padding-bottom: 18rem;
  }

  @media screen and (min-width: 769px) {
    .template-search__header {
      margin-bottom: 5rem;
    }
  }

  .search__button .icon {
    height: 1.8rem;
  }
</style>

{%- liquid
  assign sort_by = search.sort_by | default: collection.default_sort_by
  if search.url
    assign results_url = search.url
  else
    assign terms = search.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif
  assign activeFilter = false
  for filter in search.filters
    if filter.active_values.size > 0
      assign activeFilter = true
    endif
  endfor
-%}

{% include 'store-id' %}

{%- style -%}
  .section-{{ section.id }}-padding {
  padding-top: 16px;
  padding-bottom: 16px;
  }

  @media screen and (min-width: 1201px) {
  .section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  }

  .section-{{ section.id }}-padding {
  margin-top: 16px;
  margin-bottom: 16px;
  }

  @media screen and (min-width: 769px) {
  .section-{{ section.id }}-padding {
  margin-top: 32px;
  margin-bottom: 32px;
  }
  }

  @media screen and (min-width: 1201px) {
  .section-{{ section.id }}-padding {
  margin-top: 64px;
  margin-bottom: 64px;
  }
  }
{%- endstyle -%}

{% paginate search.results by 999 %}
  {% liquid
    assign found_products = 0
    assign max_market_price = 0
    assign products_array = ''
    assign sorted_products = ''

    for product in search.results
      if product.has_only_default_variant and product.metafields.jane[store_id]
        assign current_product_metadata = product.metafields.jane[store_id] | split: ','
        assign current_product_thc_value = current_product_metadata[4] | plus: 0
        assign current_product_cbd_value = current_product_metadata[5] | plus: 0
        assign current_product_market_price_value = current_product_metadata[2] | plus: 0.0

        if current_product_market_price_value == 0.0
          continue
        endif

        if current_product_market_price_value > max_market_price
          assign max_market_price = current_product_market_price_value
        endif

        if current_product_cbd_value < cbd_value_min
          continue
        endif

        if current_product_cbd_value > cbd_value_max
          continue
        endif

        if current_product_thc_value < thc_value_min
          continue
        endif

        if current_product_thc_value > thc_value_max
          continue
        endif

        if current_product_market_price_value < market_price_value_min
          continue
        endif

        if current_product_market_price_value > market_price_value_max
          continue
        endif

        assign padded_price = current_product_market_price_value | times: 100 | floor | prepend: '0000000'
        assign padded_price = padded_price | slice: -8, 8

        assign product_entry = padded_price | append: '|' | append: product.handle
        assign products_array = products_array | append: product_entry | append: ','

        assign found_products = found_products | plus: 1
      else
        for variant in product.variants
          assign variant_metadata = variant.metafields.jane[store_id] | split: ','
          assign current_variant_thc_value = variant_metadata[4] | plus: 0
          assign current_variant_cbd_value = variant_metadata[5] | plus: 0
          assign current_variant_market_price_value = variant_metadata[2] | plus: 0.0

          if current_variant_market_price_value == 0.0
            continue
          endif

          if current_variant_market_price_value > max_market_price
            assign max_market_price = current_variant_market_price_value
          endif

          if current_variant_cbd_value < cbd_value_min
            continue
          endif

          if current_variant_cbd_value > cbd_value_max
            continue
          endif

          if current_variant_thc_value < thc_value_min
            continue
          endif

          if current_variant_thc_value > thc_value_max
            continue
          endif

          if current_variant_market_price_value < market_price_value_min
            continue
          endif

          if current_variant_market_price_value > market_price_value_max
            continue
          endif

          assign padded_price = current_variant_market_price_value | times: 100 | floor | prepend: '0000000'
          assign padded_price = padded_price | slice: -8, 8

          assign variant_entry = padded_price | append: '|' | append: product.handle
          assign products_array = products_array | append: variant_entry | append: ','

          assign found_products = found_products | plus: 1

          break
        endfor
      endif
    endfor

    assign products_array = products_array | split: ','
    assign sorted_products = products_array

    if sort_by == 'market-price-ascending'
      assign sorted_products = sorted_products | sort
    elsif sort_by == 'market-price-descending'
      assign sorted_products = sorted_products | sort |  reverse
    endif

    assign sorted_products = sorted_products | reject: ''
  %}

  <div class="template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section-{{ section.id }}-padding">
    <div class="template-search__header page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <h1 class="h2 center h2 search_title">
        {%- if search.performed -%}
          {{- 'templates.search.title' | t -}}
        {%- else -%}
          {{- 'general.search.search' | t -}}
        {%- endif -%}
      </h1>
      <div class="template-search__search">
        <main-search>
          <form action="{{ routes.search_url }}" method="get" role="search" class="search">
            <div class="field">
              <input
                class="search__input field__input"
                id="Search-In-Template"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.search' | t }}"
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >
              <label class="field__label" for="Search-In-Template">{{ 'general.search.search' | t }}</label>
              <input name="sID" type="hidden" value="{{ store_id }}">

              {%- if settings.predictive_search_enabled -%}
                <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
                  {%- render 'theme-icons', icon: 'loader', class: 'predictive-search__loading-state' -%}
                </div>

                <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
              {%- endif -%}

              <button
                type="reset"
                class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                aria-label="{{ 'general.search.reset' | t }}"
              >
                <svg class="icon icon-close" aria-hidden="true" focusable="false">
                  <use xlink:href="#icon-reset">
                </svg>
              </button>
              <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                {% render 'theme-icons', icon: 'search' %}
              </button>
            </div>
          </form>
        </main-search>
      </div>
    </div>
    {%- if search.performed -%}
      <facet-filters-form class="facets facets-vertical-sort{% unless section.settings.full_width %} page-width{% endunless %} no-js-hidden facet-filters-form__header{% if section.settings.enable_filtering == false and section.settings.enable_sorting == false %} hidden{% endif %}">
        <form class="facets-vertical-form" id="FacetSortForm">
          <button type="button" class="facet--button-toggle button--primary{%- unless section.settings.enable_filtering %} hidden{% endunless %}">
            {% if section.settings.enable_filtering %}
              {% render 'theme-icons', icon: 'icon-filter-toggle' %}
              <span>{{ 'products.facets.filter_button' | t }}</span>
            {% endif %}
          </button>
          {%- if section.settings.enable_sorting %}
            <div class="facet-filters sorting caption">
              <div class="facet-filters__field">
                <p class="facet-filters__label bold small-hide">
                  <label class="h6" for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                </p>
                <div class="filter--select select_options">
                  {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
                  <select name="sort_by" class="option--select" id="SortBy" aria-describedby="a11y-refresh-page-message">
                    {%- for option in search.sort_options -%}
                      {% unless option.value contains 'price-ascending' or option.value contains 'price-descending' %}
                        <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected="selected"{% endif %}>{{ option.name | escape }}</option>
                      {% endunless %}
                    {%- endfor -%}
                    <option
                      value="market-price-ascending"
                      {% if 'market-price-ascending' == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ 'general.price.market_price_low_to_high' | t | escape }}
                    </option>
                    <option
                      value="market-price-descending"
                      {% if 'market-price-descending' == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ 'general.price.market_price_high_to_low' | t | escape }}
                    </option>
                  </select>
                  {% render 'theme-icons', icon: 'icon-chevron-down' %}
                </div>
              </div>
              <noscript>
                <button type="submit" class="facets__button-no-js button button--secondary">
                  {{ 'products.facets.sort_button' | t }}
                </button>
              </noscript>
            </div>
          {% endif %}
        </form>
        <div id="ActiveFacets" class="active-facets active-facets-desktop">
          {%- for filter in search.filters -%}
            {%- for value in filter.active_values -%}
              <facet-remove>
                <a href="{{ value.url_to_remove }}" class="active-facets__button active-facets__button--light">
                  <span class="active-facets__button-inner btn">
                    {% render 'theme-icons', icon: 'filter-close' %}
                    {{ value.label | escape }}
                    <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                  </span>
                </a>
              </facet-remove>
            {%- endfor -%}
            {% if filter.type == 'price_range' %}
              {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                <facet-remove>
                  <a href="{{ filter.url_to_remove }}" class="active-facets__button active-facets__button--light">
                    <span class="active-facets__button-inner btn">
                      {% render 'theme-icons', icon: 'filter-close' %}
                      {%- if filter.min_value.value -%}
                        {{ filter.min_value.value | money }}
                      {%- else -%}
                        {{ 0 | money }}
                      {%- endif -%}
                      -
                      {%- if filter.max_value.value -%}
                        {{ filter.max_value.value | money }}
                      {%- else -%}
                        {{ filter.range_max | money }}
                      {%- endif -%}
                      <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                    </span>
                  </a>
                </facet-remove>
              {%- endif -%}
            {% endif %}
          {%- endfor -%}
          {% if market_price_value_max < 9999 and market_price_value_max != max_market_price or market_price_value_min > 0 %}
            {%- liquid
              assign new_params = ''
              assign has_filter = true

              for param in params_array
                assign key_value = param | split: '='
                if key_value[0] != 'filter.v.mp.gte' and key_value[0] != 'filter.v.mp.lte' and key_value[0] != 'section_id'
                  if new_params == ''
                    assign new_params = param
                  else
                    assign new_params = new_params | append: '&' | append: param
                  endif
                endif
              endfor

              assign updated_url = 'https://' | append: pageUrl | split: '?' | first | append: '?' | append: new_params
            -%}

            {% if has_filter %}
              <a href="{{ updated_url }}" class="active-facets__button active-facets__button--light">
                  <span class="active-facets__button-inner btn">
                    {% render 'theme-icons', icon: 'filter-close' %}
                    {{ 'general.price.market_price' | t }}: {{ market_price_value_min | times: 100 | money }} - {{ market_price_value_max | times: 100 | money }}
                    <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                  </span>
              </a>
            {% endif %}
          {% endif %}

          {% if cbd_value_min > 0 or cbd_value_max < 100 %}
            {%- liquid
              assign new_params = ''
              assign has_filter = true

              for param in params_array
                assign key_value = param | split: '='
                if key_value[0] != 'filter.v.cbd.gte' and key_value[0] != 'filter.v.cbd.lte' and key_value[0] != 'section_id'
                  if new_params == ''
                    assign new_params = param
                  else
                    assign new_params = new_params | append: '&' | append: param
                  endif
                endif
              endfor

              assign updated_url = 'https://' | append: pageUrl | split: '?' | first | append: '?' | append: new_params
            -%}

            <a href="{{ updated_url }}" class="active-facets__button active-facets__button--light">
                <span class="active-facets__button-inner btn">
                  {% render 'theme-icons', icon: 'filter-close' %}
                  CBD: {{ cbd_value_min }}% - {{ cbd_value_max }}%
                  <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                </span>
            </a>
          {% endif %}

          {% if thc_value_min > 0 or thc_value_max < 100 %}
            {%- liquid
              assign new_params = ''
              assign has_filter = true

              for param in params_array
                assign key_value = param | split: '='
                if key_value[0] != 'filter.v.thc.gte' and key_value[0] != 'filter.v.thc.lte' and key_value[0] != 'section_id'
                  if new_params == ''
                    assign new_params = param
                  else
                    assign new_params = new_params | append: '&' | append: param
                  endif
                endif
              endfor

              assign updated_url = 'https://' | append: pageUrl | split: '?' | first | append: '?' | append: new_params
            -%}

            <a href="{{ updated_url }}" class="active-facets__button active-facets__button--light">
                <span class="active-facets__button-inner btn">
                  {% render 'theme-icons', icon: 'filter-close' %}
                  THC: {{ thc_value_min }}% - {{ thc_value_max }}%
                  <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                </span>
            </a>
          {% endif %}

          {% if has_filter %}
            <a href="{{ results_url | append: '?sID=' | append: store_id }}" class="active-facets__button-remove link--underline bold">
              <span>{{ 'products.facets.clear_all' | t }}</span>
            </a>
          {% endif %}
        </div>
      </facet-filters-form>

      <div class="facets-vertical page-width">
        {%- if search.filters != empty -%}
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            <aside
              aria-labelledby="verticalTitle"
              class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
              id="main-search-filters"
              data-id="{{ section.id }}"
            >
              {% render 'facets',
                results: search,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting,
                filter_type: 'vertical',
                color_swatch: section.settings.color_filter,
                paginate: paginate,
                cbd_value_min: cbd_value_min,
                cbd_value_max: cbd_value_max,
                thc_value_min: thc_value_min,
                thc_value_max: thc_value_max,
                market_price_value_min: market_price_value_min,
                market_price_value_max: market_price_value_max,
                max_market_price: max_market_price
              %}
            </aside>
          {%- endif -%}
        {%- endif -%}
        <div class="product-grid-container" id="ProductGridContainer">
          {%- if search.results.size == 0 and search.filters != empty -%}
            <div
              class="template-search__results collection collection--empty"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: search_url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div
              class="template-search__results collection marquee-scrolling__option"
              id="product-grid"
              data-id="{{ section.id }}"
              data-scrolling="true"
            >
              {%- if search.performed -%}
                <div class="search-empty__results">
                  {%- unless section.settings.enable_filtering or section.settings.enable_sorting -%}
                    {%- if search.results_count > 0 -%}
                      <div class="search-svg__icon">
                        {% render 'theme-icons', icon: 'search' %}
                      </div>
                      <p class="h2 mg-none" role="status">
                        {{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}
                      </p>
                      <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
                        {{ 'general.continue_shopping' | t }}
                      </a>
                    {%- endif -%}
                  {%- endunless -%}
                  {%- if search.results_count == 0 and search.filters == empty -%}
                    <div class="search-svg__icon">
                      {% render 'theme-icons', icon: 'search' %}
                    </div>
                    <p class="h2 mg-none" role="status">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
                    <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
                      {{ 'general.continue_shopping' | t }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}


              {% assign blog_check_list = 0 %}
              {% assign page_check_list = 0 %}
              <div class="loading-overlay gradient"></div>
              <ul
                class="grid product-grid  grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                role="list"
              >
                {%- for product_entry in sorted_products -%}
                  {% assign product_details = product_entry | split: '|' %}
                  {% assign product_handle = product_details[1] %}
                  {% assign variant_id = product_details[2] %}
                  {% assign item = search.results | where: 'handle', product_handle | first %}

                  {% if item.object_type == 'article' %}
                    {% assign blog_check_list = 1 %}
                  {% endif %}
                  {% if item.object_type == 'page' %}
                    {% assign page_check_list = 1 %}
                  {% endif %}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {% liquid
                        assign is_available_in_store = false
                        assign purchase_price = product_metadata[1]

                        if purchase_price != blank and purchase_price != '0.00' and purchase_price != 'N.A.'
                          assign is_available_in_store = true
                        endif
                      %}
                      <li
                        class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                        {% if settings.animations_reveal_on_scroll %}
                          data-cascade
                        {% endif %}
                        {% if item.tags contains 'Elite' %} elite-one {% endif %}
                      >
                        {% render 'card-product',
                          card_product: item,
                          media_aspect_ratio: section.settings.image_ratio,
                          image_shape: 'default',
                          horizontal_quick_add: true,
                          grid_text_alignment: section.settings.grid_text_alignment,
                          grid_color_scheme: section.settings.grid_color_scheme,
                          grid_style: section.settings.grid_style,
                          show_secondary_image: section.settings.show_secondary_image,
                          show_vendor: section.settings.show_vendor,
                          show_rating: section.settings.show_rating,
                          show_quick_add: false,
                          show_color_swatches: false,
                          lazy_load: false,
                          section_id: section.id,
                          store_id: store_id,
                          is_available_in_store: is_available_in_store,
                          params_array: params_array
                        %}
                      </li>
                  {%- endcase -%}
                {%- endfor -%}
              </ul>

              {% if blog_check_list == 1 %}
                <div class="search-other-items">
                  <h4 class="top_blog_heading">{{ 'templates.search.search_blog' | t }}</h4>
                  <ul
                    class="grid product-grid  grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop search_page_blog"
                    role="list"
                  >
                    {%- for item in search.results -%}
                      {% assign lazy_load = false %}
                      {%- if forloop.index > 2 -%}
                        {%- assign lazy_load = true -%}
                      {%- endif -%}
                      {%- case item.object_type -%}
                        {%- when 'article' -%}
                          <li
                            class="{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                            {% if settings.animations_reveal_on_scroll %}
                              data-cascade
                            {% endif %}
                          >
                            {% render 'article-card',
                              blog: section.settings.blog,
                              image_right: section.settings.image_second,
                              article: item,
                              color_scheme: section.settings.color_scheme_blog,
                              media_aspect_ratio: section.settings.image_ratios,
                              custom_ratio: section.settings.custom_ratio,
                              show_date: section.settings.show_date,
                              show_author: section.settings.show_author,
                              show_excerpt: true
                            %}
                          </li>
                      {%- endcase -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {% endif %}
              {% if page_check_list == 1 %}
                <div class="search-other-items">
                  <h4 class="top_blog_heading">{{ 'templates.search.search_page' | t }}</h4>
                  <ul class="list-menu list-menu--inline button--style page_list_search">
                    {%- for item in search.results -%}
                      {%- case item.object_type -%}
                        {%- when 'page' -%}
                          <li>
                            <a href="{{ item.url }}" class="header__menu-item list-menu__item link link--text focus-inset header__menu-button">
                              {% render 'theme-icons', icon: 'top-arrow' %}
                              <span class="link--hover">{{ item.title | truncate: 50 | escape }}</span>
                            </a>
                          </li>
                      {%- endcase -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {% endif %}
              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{% endpaginate %}
<script>
